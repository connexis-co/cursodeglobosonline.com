# Copia a .env y completa. Estas variables PUBLIC_* llegan al bundle del navegador.

# Google Tag Manager (contenedor existente del sitio: GTM-KKP7WL8Q)
PUBLIC_GTM_ID=

# GA4 directo (opcional; recomendado dejar vacío y medir solo vía GTM
# para no duplicar hits — el contenedor ya dispara G-PHN6J5MTX6)
PUBLIC_GA4_ID=

# Meta Pixel (pendiente de crear; el sitio anterior no tenía)
PUBLIC_META_PIXEL_ID=

# Afiliado Hotmart extra (los hotm.art ya llevan el hotlink; dejar vacío normalmente)
PUBLIC_HOTMART_AFFILIATE=

# Backend de leads (Fase 2 — Laravel cursodeglobosonline-core)
PUBLIC_LEADS_ENDPOINT=

# CDN de assets en R2 (Fase 2)
PUBLIC_CDN_URL=
