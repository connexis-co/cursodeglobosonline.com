{
  "name": "cursodeglobosonline-emdash",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "deploy": "node scripts/deploy-emdash.mjs",
    "cf-typegen": "wrangler types",
    "test:ratings": "node scripts/test-ratings.mjs",
    "prepare": "husky",
    "deploy:dev": "npm run build && node scripts/deploy-emdash.mjs",
    "content:seed": "node --import tsx scripts/migrate-content.ts",
    "test:migration": "node --import tsx --test tests/*.test.ts",
    "db:migrate:dev": "wrangler d1 migrations apply globos-ratings-dev --remote",
    "build:prod": "GLOBOS_BUILD_ENV=production astro build",
    "deploy:prod": "npm run build:prod && node scripts/deploy-production.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@emdash-cms/cloudflare": "1.1.0",
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/nunito-sans": "^5.2.0",
    "@nanostores/persistent": "^1.0.0",
    "@nanostores/react": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.4",
    "emdash": "1.1.0",
    "emdash-smtp": "0.4.0",
    "github-slugger": "2.0.0",
    "lucide-react": "^0.545.0",
    "nanostores": "^1.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "5.20261002.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "husky": "^9.1.7",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "unified": "^11.0.5",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "keyv": "<6.0.0",
    "flat-cache": "<6.1.24",
    "file-entry-cache": "<11.1.6",
    "cacheable": "<2.5.1",
    "cacheable-request": "<13.0.20",
    "cache-manager": "<7.2.10",
    "ecto": "<5.0.1",
    "@cacheable/memory": "<2.2.1",
    "@cacheable/node-cache": "<3.1.2",
    "@cacheable/utils": "<2.5.1",
    "@cacheable/net": "<2.1.1",
    "emdash-smtp-node-transports": {
      "nodemailer": "10.0.13"
    }
  },
  "emdash": {
    "seed": "emdash.seed.json"
  }
}
