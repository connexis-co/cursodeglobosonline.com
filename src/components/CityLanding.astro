---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Balloons from '@/components/Balloons.astro';
import Wave from '@/components/Wave.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CourseCard from '@/components/CourseCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import type { Country, City } from '@/lib/countries';
import { getCityLocal } from '@/lib/cities';
import { breadcrumbSchema, faqSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';

interface Props {
  country: Country;
  city: City;
}

const { country, city } = Astro.props;
const cityLocal = getCityLocal(city.slug);

const courses = (await getCollection('courses')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);
const allTestimonials = await getCollection('testimonials');
const testimonials = [
  ...allTestimonials.filter((t) => t.data.citySlug === city.slug),
  ...allTestimonials.filter((t) => t.data.countryCode === country.code && t.data.citySlug !== city.slug),
  ...allTestimonials.filter((t) => t.data.countryCode !== country.code),
].slice(0, 3);

const faqs = [
  ...(cityLocal?.faqs ?? []),
  {
    q: `¿Los cursos son presenciales en ${city.name}?`,
    a: `Son 100% online, y esa es la ventaja: estudias desde cualquier punto de ${city.name} a tu ritmo, sin traslados, y repites cada técnica las veces que quieras antes de un evento real.`,
  },
  {
    q: `¿Cómo pago desde ${country.name}?`,
    a: `En Hotmart, con tarjetas y métodos locales de ${country.name}; el precio se muestra en ${country.currency} antes de confirmar. El acceso llega a tu correo al instante.`,
  },
];

const title = `Cursos de Decoración con Globos en ${city.name} 🎈 Online`;
const description = `Cursos de decoración con globos para ${city.name}, ${country.name}: globoflexia, bouquets, flores y globos burbuja con certificado. 100% online, precios en ${country.currency}.`;
---

<BaseLayout
  {title}
  {description}
  {country}
  pathAfterCountry="/"
  schemas={[
    faqSchema(faqs),
    breadcrumbSchema([
      { name: 'Inicio', url: `${SITE.url}/${country.code}/` },
      { name: city.name, url: `${SITE.url}/${country.code}/${city.slug}/` },
    ]),
  ]}
  pageType="city_home"
>
  <section class="relative overflow-hidden bg-crema-100 pt-6 lg:pt-8">
    <Balloons variant="corner-right" />
    <div class="contenedor relative pb-12 lg:pb-16">
      <nav class="mb-8 text-xs text-ciruela-400" aria-label="Miga de pan">
        <a href={`/${country.code}/`} class="hover:text-coral-600">{country.flag} {country.name}</a>
        <span aria-hidden="true"> / </span>
        <span class="font-bold text-ciruela-600">{city.name}</span>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-xs font-extrabold text-ciruela-700 shadow-tarjeta">
          {country.flag} {city.name}, {country.name}
        </span>
        <h1 class="mt-4 text-3xl font-semibold text-balance text-ciruela-900 sm:text-4xl lg:text-5xl">
          Cursos de decoración con globos en {city.name}
        </h1>
        {cityLocal && <p class="mt-5 max-w-2xl leading-relaxed text-ciruela-600">{cityLocal.hook}</p>}
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="#cursos-ciudad"
            class="rounded-xl bg-coral-500 px-7 py-3.5 text-sm font-bold text-white shadow-boton transition-all duration-300 ease-fiesta hover:-translate-y-0.5 hover:bg-coral-600"
          >
            Ver los cursos
          </a>
          <span class="text-xs text-ciruela-500">
            🎓 Certificado incluido · ♾️ Acceso de por vida · 🛡️ Garantía 7 días
          </span>
        </div>
      </div>
    </div>
    <Wave color="var(--color-crema-50)" />
  </section>

  <section id="cursos-ciudad" class="contenedor scroll-mt-24 py-14 lg:py-16">
    <SectionHeading
      eyebrow={`Disponibles en ${city.name}`}
      title="Elige tu especialidad"
      lead={`Los cuatro cursos se estudian 100% online desde ${city.name}, con checkout en ${country.currency} y métodos de pago de ${country.name}.`}
    />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        courses.map((course, i) => (
          <div class="scroll-reveal" style={`animation-delay:${i * 60}ms`}>
            <CourseCard {course} {country} {city} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-crema-100 py-14">
    <div class="contenedor">
      <SectionHeading eyebrow="Estudiantes" title="Lo que cuentan quienes ya empezaron" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          testimonials.map((t, i) => (
            <div class="scroll-reveal" style={`animation-delay:${i * 60}ms`}>
              <TestimonialCard testimonial={t} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="contenedor max-w-4xl py-14">
    <SectionHeading
      eyebrow="Preguntas frecuentes"
      title={`Dudas frecuentes desde ${city.name}`}
      align="center"
    />
    <div class="mt-8">
      <FaqAccordion faqs={faqs} />
    </div>
  </section>

  <section class="contenedor pb-16">
    <div class="rounded-[2rem] border border-crema-200 bg-crema-100 p-8">
      <p class="text-xs font-bold tracking-[0.18em] text-ciruela-400 uppercase">
        También estamos en otras ciudades de {country.name}
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          country.cities
            .filter((c) => c.slug !== city.slug)
            .map((c) => (
              <a
                href={`/${country.code}/${c.slug}/`}
                class="rounded-full border border-crema-300 bg-white px-3.5 py-1.5 text-xs font-bold text-ciruela-600 transition-colors hover:border-coral-300 hover:text-coral-600"
              >
                {c.name}
              </a>
            ))
        }
        <a
          href={`/${country.code}/`}
          class="rounded-full bg-coral-500 px-3.5 py-1.5 text-xs font-extrabold text-white transition-colors hover:bg-coral-600"
        >
          Todo {country.name} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
