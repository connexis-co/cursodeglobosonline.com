---
/**
 * Sugerencia de país no intrusiva: si el idioma del navegador indica otro
 * mercado y no hay país guardado, propone cambiar. Persiste en localStorage.
 */
interface Props {
  pathAfterCountry?: string;
  currentCode?: string;
}
const { pathAfterCountry = '/', currentCode = '' } = Astro.props;
---

<div
  id="geo-toast"
  data-path={pathAfterCountry}
  data-current={currentCode}
  class="fixed inset-x-4 bottom-24 z-40 hidden max-w-sm rounded-2xl border border-crema-200 bg-white p-4 shadow-globo sm:left-auto sm:right-5"
  role="status"
>
  <p class="text-sm font-semibold text-ciruela-800">
    ¿Estás en <span id="geo-toast-name"></span>? Te mostramos precios en tu moneda.
  </p>
  <div class="mt-3 flex gap-2">
    <a
      id="geo-toast-go"
      href="/"
      class="rounded-full bg-coral-500 px-4 py-2 text-xs font-bold text-white transition-colors hover:bg-coral-600"
    >
      Sí, cambiar
    </a>
    <button
      id="geo-toast-stay"
      class="rounded-full border border-crema-300 px-4 py-2 text-xs font-bold text-ciruela-600 transition-colors hover:bg-crema-100"
    >
      Seguir aquí
    </button>
  </div>
</div>

<script>
  import { trackEvent } from '@/lib/analytics';

  const toast = document.getElementById('geo-toast');
  const NAMES: Record<string, string> = {
    co: 'Colombia',
    mx: 'México',
    pe: 'Perú',
    ec: 'Ecuador',
    cl: 'Chile',
    ar: 'Argentina',
    es: 'España',
    us: 'Estados Unidos',
  };

  if (toast) {
    const saved = localStorage.getItem('cdgo-country');
    const dismissed = sessionStorage.getItem('cdgo-geo-dismissed');
    const current = toast.dataset.current ?? '';
    const region = (navigator.language.split('-')[1] ?? '').toLowerCase();
    const detected = region in NAMES ? region : '';

    // Solo sugerir si: hay detección, no coincide con la página, y no se decidió antes.
    const target = saved && saved !== current ? saved : detected && detected !== current ? detected : '';
    if (target && !dismissed && NAMES[target] && current !== target) {
      const name = document.getElementById('geo-toast-name');
      const go = document.getElementById('geo-toast-go') as HTMLAnchorElement | null;
      if (name) name.textContent = NAMES[target];
      if (go) {
        go.href = `/${target}${toast.dataset.path ?? '/'}`;
        go.addEventListener('click', () => {
          localStorage.setItem('cdgo-country', target);
          trackEvent('select_country', { country_from: current || 'none', country_to: target, source: 'geo_toast' });
        });
      }
      document.getElementById('geo-toast-stay')?.addEventListener('click', () => {
        sessionStorage.setItem('cdgo-geo-dismissed', '1');
        toast.classList.add('hidden');
      });
      setTimeout(() => toast.classList.remove('hidden'), 2200);
    }
  }
</script>
