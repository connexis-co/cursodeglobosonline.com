---
/**
 * Contenido de landing para Ads (§8.2-8.3). variant "meta": interrupción,
 * copy emocional. variant "google": búsqueda activa, copy directo a datos.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Balloons from './Balloons.astro';
import CourseCover from './CourseCover.astro';
import HotmartBadge from './HotmartBadge.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Rating from './Rating.astro';
import TestimonialCard from './TestimonialCard.astro';
import Wave from './Wave.astro';
import { COUNTRIES, DEFAULT_COUNTRY, formatPrice } from '@/lib/countries';
import { getCategory } from '@/lib/categories';
import { coursePricing, usd } from '@/lib/pricing';
import { buildHotmartUrl } from '@/lib/hotmart';
import { SITE } from '@/lib/site';

interface Props {
  course: CollectionEntry<'courses'>;
  variant: 'meta' | 'google';
}

const { course, variant } = Astro.props;
const d = course.data;
const country = COUNTRIES.find((c) => c.code === DEFAULT_COUNTRY)!;
const category = getCategory(d.category);
const { hasPrice, hasDiscount, discountPct } = coursePricing(d);

const checkoutUrl = buildHotmartUrl({
  baseUrl: d.hotmartUrl,
  coupon: d.coupon,
  courseSlug: course.id,
  countryCode: country.code,
  variant: `landing-${variant}`,
});

const isMeta = variant === 'meta';
const h1 = isMeta
  ? `Imagina cobrar por decorar las fiestas de tu ciudad`
  : `${d.title} — ${discountPct ? `${discountPct}% OFF hoy` : 'inscripción abierta'}`;
const sub = isMeta
  ? `El ${d.title} te lleva de cero a tus primeros pedidos: ${d.lessonsCount} videos paso a paso, certificado de estudios y acceso para siempre.`
  : `${d.lessonsCount} videos paso a paso · Certificado de estudios · Acceso de por vida · Garantía de 7 días.`;
// Meta: CTA concreto con la técnica («Quiero aprender globoflexia»), sin emoji como icono.
// Todo en minúscula: los títulos llevan mayúscula a mitad («Bouquets de Globos»).
const skill = d.title.replace(/^Curso de /i, '');
const cta = isMeta
  ? `Quiero aprender ${skill.toLowerCase()}`
  : discountPct
    ? `Inscribirme con ${discountPct}% OFF`
    : 'Inscribirme ahora';

const trackParams = JSON.stringify({
  course_name: d.title,
  course_category: category.name,
  price: d.priceUSD ?? '',
  currency: d.priceUSD !== undefined ? 'USD' : '',
  placement: `landing_${variant}`,
});

const incluye = [
  `${d.lessonsCount} lecciones en video, técnica en cámara`,
  'Certificado de estudios con validez internacional',
  'Acceso de por vida, desde celular o computador',
  'Tareas calificadas y asistencia académica',
  'Bonos prácticos incluidos',
  'Garantía de 7 días — devolución del 100%',
];

// Reseñas REALES de Hotmart (testimonials.json): primero las de este curso y luego las de
// otros cursos (el chip de cada tarjeta dice cuál). Nada de citas inventadas en tráfico pagado.
const allTestimonials = await getCollection('testimonials');
// Relleno alternando cursos (una reseña de cada uno antes de repetir), para que un curso
// sin reseñas propias no muestre tres del mismo curso ajeno.
const seen = new Map<string, number>();
const others = allTestimonials
  .filter((t) => t.data.courseSlug !== course.id)
  .map((t) => {
    const rank = seen.get(t.data.courseSlug) ?? 0;
    seen.set(t.data.courseSlug, rank + 1);
    return { t, rank };
  })
  .sort((a, b) => a.rank - b.rank)
  .map(({ t }) => t);
const testimonials = [...allTestimonials.filter((t) => t.data.courseSlug === course.id), ...others].slice(0, 3);

const faqs = [
  {
    q: '¿Necesito experiencia previa?',
    a: 'No. El curso empieza desde cero y avanza paso a paso hasta las técnicas más vendidas.',
  },
  {
    q: '¿Cómo accedo al curso?',
    a: 'Pagas en Hotmart (métodos locales de tu país) y el acceso llega a tu correo al instante.',
  },
  {
    q: '¿El certificado es válido?',
    a: 'Sí, es un certificado de estudios digital con validez internacional y verificación en línea.',
  },
  {
    q: '¿Y si no me gusta?',
    a: 'Tienes 7 días de garantía: Hotmart te devuelve el 100% de tu dinero, sin preguntas.',
  },
];
---

<!-- Mini header -->
<header class="border-b border-crema-200 bg-crema-50">
  <div class="contenedor flex h-14 items-center justify-between">
    <Logo size={30} />
    {
      discountPct && (
        <span class="rounded-full bg-coral-600 px-4 py-1.5 text-xs font-extrabold text-white">
          {discountPct}% de descuento
        </span>
      )
    }
  </div>
</header>

<main>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ciruela-900 text-crema-50">
    <Balloons variant="corner-right" />
    <!-- Mobile: título → imagen → precio y CTA. Desktop: texto izq., imagen der. -->
    <div class="contenedor grid items-start gap-x-10 gap-y-6 py-14 lg:grid-cols-[1.1fr_1fr] lg:py-20">
      <div class="lg:col-start-1 lg:self-center">
        <h1 class="text-3xl font-semibold text-balance sm:text-4xl lg:text-5xl">{h1}</h1>
        <p class="mt-4 max-w-lg text-base text-crema-100/85">{sub}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          {d.rating && <Rating rating={d.rating} count={d.ratingCount} />}
          <span class="inline-flex items-center gap-1.5 text-crema-100/75">
            <Icon name="birrete" class="text-sol-300" />{SITE.stats.students} estudiantes certificados
          </span>
        </div>
      </div>

      <div class="order-last lg:col-start-1">
        {
          hasPrice && (
            <p>
              {hasDiscount && (
                <span class="text-sm text-crema-100/70">
                  Antes <s>{usd(d.originalPriceUSD!)}</s>
                </span>
              )}
              <span class="font-display mx-3 text-4xl font-bold text-sol-300">{usd(d.priceUSD!)}</span>
              <span class="text-xs text-crema-100/70">≈ {formatPrice(d.priceUSD!, country)}</span>
            </p>
          )
        }
        <a
          href={checkoutUrl}
          target="_blank"
          rel="noopener"
          data-track="begin_checkout"
          data-track-params={trackParams}
          class:list={[
            'inline-block rounded-xl bg-coral-600 px-9 py-4 text-sm font-bold text-white shadow-boton transition-all duration-300 ease-fiesta hover:-translate-y-1 hover:bg-coral-700',
            hasPrice && 'mt-5',
          ]}
        >
          {cta}
        </a>
        <p class="mt-3.5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm font-semibold text-crema-100/80">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="escudo" class="text-sol-300" />Garantía de 7 días · Acceso inmediato
          </span>
          <HotmartBadge tone="dark" />
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-sm lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center">
        <div class="overflow-hidden rounded-3xl border-4 border-crema-50/15 shadow-globo sm:rotate-2">
          {
            d.cover ? (
              <img
                src={d.cover}
                alt={`Imagen del ${d.title}`}
                class="aspect-[16/10] w-full object-cover sm:aspect-[4/3]"
                width="600"
                height="450"
                fetchpriority="high"
              />
            ) : (
              <div class="aspect-[16/10] w-full sm:aspect-[4/3]">
                <CourseCover slug={course.id} category={d.category} title={d.title} />
              </div>
            )
          }
        </div>
      </div>
    </div>
    <Wave color="var(--color-crema-50)" />
  </section>

  <!-- Prueba social rápida: reseñas reales citadas de la ficha pública de Hotmart -->
  <section class="contenedor py-10" aria-labelledby="resenas-titulo">
    <h2 id="resenas-titulo" class="text-xs font-extrabold tracking-[0.18em] text-coral-600 uppercase">
      Reseñas reales de alumnas en Hotmart
    </h2>
    <div class="mt-4 grid gap-5 md:grid-cols-3">
      {testimonials.map((t) => <TestimonialCard testimonial={t} />)}
    </div>
  </section>

  <!-- Qué incluye -->
  <section class="contenedor pb-12">
    <h2 class="font-display text-center text-2xl font-semibold text-ciruela-900 sm:text-3xl">
      {isMeta ? 'Todo lo que te llevas' : 'Qué incluye tu inscripción'}
    </h2>
    <div class="mx-auto mt-8 grid max-w-3xl gap-3 sm:grid-cols-2">
      {
        incluye.map((item) => (
          <div class="flex items-start gap-3 rounded-2xl bg-white p-4 shadow-tarjeta">
            <Icon name="check" size={18} class="mt-px text-coral-600" />
            <span class="text-sm font-semibold text-ciruela-700">{item}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA intermedio -->
  <section class="bg-crema-100 py-12">
    <div class="contenedor text-center">
      {
        hasPrice ? (
          <p class="text-sm text-ciruela-500">
            Hoy: {hasDiscount && <s>{usd(d.originalPriceUSD!)}</s>}
            <span class="font-display mx-2 text-3xl font-bold text-coral-700">{usd(d.priceUSD!)}</span>
            {hasDiscount && discountPct && <span class="font-bold text-coral-700">({discountPct}% OFF)</span>}
            <span class="block text-xs">≈ {formatPrice(d.priceUSD!, country)} · Hotmart confirma el valor exacto</span>
          </p>
        ) : (
          <p class="text-sm font-bold text-ciruela-600">Precio en tu moneda, visible antes de pagar.</p>
        )
      }
      <a
        href={checkoutUrl}
        target="_blank"
        rel="noopener"
        data-track="begin_checkout"
        data-track-params={trackParams}
        class="mt-5 inline-block rounded-xl bg-coral-600 px-9 py-4 text-sm font-bold text-white shadow-boton transition-all duration-300 ease-fiesta hover:-translate-y-0.5 hover:bg-coral-700"
      >
        {cta}
      </a>
      <p class="mt-4 text-xs text-ciruela-500">El descuento se aplica automáticamente en el enlace.</p>
    </div>
  </section>

  <!-- Garantía -->
  <section class="contenedor py-12">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 rounded-3xl border-2 border-dashed border-aqua-500 bg-aqua-100/40 p-8 text-center sm:flex-row sm:text-left">
      <span class="flex h-16 w-16 shrink-0 rotate-[-4deg] items-center justify-center rounded-2xl bg-white text-aqua-700 shadow-tarjeta">
        <Icon name="escudo" size={34} strokeWidth={1.6} />
      </span>
      <div>
        <h2 class="font-display text-xl font-semibold text-ciruela-900">7 días de garantía, sin preguntas</h2>
        <p class="mt-1.5 text-sm text-ciruela-600">
          Entra al curso, mira las lecciones y decide. Si no es para ti, Hotmart te devuelve el 100% de tu
          dinero dentro de los primeros 7 días.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ mínimo -->
  <section class="contenedor max-w-2xl pb-12">
    <h2 class="font-display text-center text-2xl font-semibold text-ciruela-900">Preguntas rápidas</h2>
    <div class="mt-6 divide-y divide-crema-200 rounded-3xl border border-crema-200 bg-white shadow-tarjeta">
      {
        faqs.map((faq) => (
          <details class="group px-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-sm font-bold text-ciruela-800 [&::-webkit-details-marker]:hidden">
              {faq.q}
              <span class="text-coral-600 transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <p class="pb-4 text-sm text-ciruela-500">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- CTA final -->
  <section class="relative overflow-hidden bg-coral-700 py-14 text-center text-white">
    <Balloons variant="rise" />
    <div class="contenedor relative">
      <h2 class="mx-auto max-w-xl text-3xl font-semibold text-balance">
        {isMeta ? 'Tu nueva habilidad te está esperando' : 'Última oportunidad: inscríbete ahora'}
      </h2>
      <p class="mt-3 text-sm text-white/90">Acceso inmediato tras el pago · Certificado incluido</p>
      <a
        href={checkoutUrl}
        target="_blank"
        rel="noopener"
        data-track="begin_checkout"
        data-track-params={trackParams}
        class="mt-6 inline-block rounded-xl bg-white px-10 py-4 text-sm font-bold text-coral-700 shadow-globo transition-all duration-300 ease-fiesta hover:-translate-y-1"
      >
        {cta}
      </a>
    </div>
  </section>
</main>

<!-- Mini footer -->
<footer class="bg-ciruela-900 py-8 text-center text-xs text-crema-100/60">
  <div class="contenedor space-y-2">
    <p>© {new Date().getFullYear()} {SITE.name} · Una filial de Sably</p>
    <p>
      <a href="/legal/terminos/" class="underline hover:text-crema-100">Términos</a> ·
      <a href="/legal/privacidad/" class="underline hover:text-crema-100">Privacidad</a> ·
      <a href={`mailto:${SITE.email}`} class="underline hover:text-crema-100">{SITE.email}</a>
    </p>
  </div>
</footer>
