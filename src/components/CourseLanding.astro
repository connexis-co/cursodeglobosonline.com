  /* Prosa del cuerpo MDX con la voz tipográfica del sitio */
  .prosa :global(p) {
    margin-block: 1rem;
    line-height: 1.75;
    color: var(--color-ciruela-600);
  }
  .prosa :global(h3) {
    margin-top: 2.2rem;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-ciruela-900);
  }
</style>
