---
import type { CollectionEntry } from 'astro:content';
import type { Country } from '@/lib/countries';
import { formatPrice } from '@/lib/countries';
import { getCategory } from '@/lib/categories';
import { coursePricing, usd } from '@/lib/pricing';
import CourseCover from './CourseCover.astro';
import Rating from './Rating.astro';

interface Props {
  course: CollectionEntry<'courses'>;
  country?: Country;
  /** Card grande para grid asimétrico. */
  large?: boolean;
}

const { course, country, large = false } = Astro.props;
const d = course.data;
const category = getCategory(d.category);
// Siempre la URL canónica del curso (las curso-ciudad declaran canonical → curso-país).
const href = `/${country?.code ?? 'co'}/${course.id}/`;
const { hasPrice, hasDiscount, discountPct } = coursePricing(d);
---

<a
  href={href}
  class:list={[
    'course-card group relative flex flex-col overflow-hidden rounded-3xl border border-crema-200 bg-white shadow-tarjeta',
    large && 'lg:row-span-2',
  ]}
>
  <div class:list={['relative overflow-hidden', large ? 'aspect-square sm:aspect-[16/10] lg:aspect-square' : 'aspect-[16/9]']}>
    {
      d.cover ? (
        <img
          src={d.cover}
          alt={`Imagen del ${d.title}`}
          class="h-full w-full object-cover transition-transform duration-700 ease-suave group-hover:scale-105"
          loading="lazy"
          decoding="async"
          width="600"
          height="600"
        />
      ) : (
        <CourseCover
          slug={course.id}
          category={d.category}
          title={d.title}
          class="transition-transform duration-700 ease-suave group-hover:scale-105"
        />
      )
    }
    <span
      class="absolute top-3 left-3 rounded-full bg-white/90 px-3 py-1 text-xs font-extrabold text-ciruela-700 backdrop-blur-sm"
    >
      {category.emoji} {category.name}
    </span>
    {
      hasDiscount && discountPct && (
        <span class="absolute top-3 right-3 rounded-full bg-coral-600 px-3 py-1 text-xs font-extrabold text-white">
          −{discountPct}%
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-2.5 p-5">
    <h3 class:list={['font-display font-semibold text-ciruela-900', large ? 'text-2xl' : 'text-lg']}>
      {d.title}
    </h3>
    {large && <p class="line-clamp-2 text-sm text-ciruela-500">{d.shortDescription}</p>}
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ciruela-500">
      <span>📹 {d.lessonsCount} videos</span>
      <span>· {d.level}</span>
      <span>· 🎓 Certificado</span>
      {d.rating && <Rating rating={d.rating} count={d.ratingCount} />}
    </div>
    <div class="mt-auto flex items-baseline gap-2 pt-1.5">
      {
        hasPrice ? (
          <>
            {hasDiscount && <span class="text-xs text-ciruela-500 line-through">{usd(d.originalPriceUSD!)}</span>}
            <span class="text-lg font-extrabold text-coral-700">{usd(d.priceUSD!)}</span>
            {country && <span class="text-xs text-ciruela-500">≈ {formatPrice(d.priceUSD!, country)}</span>}
          </>
        ) : (
          <span class="text-sm font-extrabold text-coral-700">Ver temario y precio →</span>
        )
      }
    </div>
  </div>

  <span
    class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/25 to-transparent transition-transform duration-700 ease-suave group-hover:translate-x-full"
    aria-hidden="true"></span>
</a>

<style>
  .course-card {
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.4s ease;
  }
  .course-card:hover {
    transform: translateY(-8px) scale(1.015);
    box-shadow: var(--shadow-globo);
  }
</style>
