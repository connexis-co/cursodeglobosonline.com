---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { COUNTRIES, DEFAULT_COUNTRY, type Country } from '@/lib/countries';
import { CATEGORIES } from '@/lib/categories';
import { SITE } from '@/lib/site';

interface Props {
  country?: Country;
}

const { country } = Astro.props;
const base = `/${country?.code ?? DEFAULT_COUNTRY}`;

// Solo categorías con cursos (las vacías no tienen página → evitaba 404 internos).
// Los temas sin curso propio (eventos, emprendimiento) viven en el blog.
const courses = await getCollection('courses');
const topicLinks = CATEGORIES.map((cat) =>
  courses.some((c) => c.data.category === cat.slug)
    ? { href: `${base}/cursos/${cat.slug}/`, label: `${cat.emoji} ${cat.name}` }
    : {
        href: cat.slug === 'eventos' ? '/blog/#ideas-por-ocasion' : '/blog/#negocio',
        label: `${cat.emoji} ${cat.name}`,
      },
);

const socialIcons: Record<string, string> = {
  instagram:
    'M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 2.3c-3.1 0-3.5 0-4.7.1-1.1.1-1.4.2-1.7.3-.4.2-.7.3-1 .6-.3.3-.5.6-.6 1-.1.3-.3.6-.3 1.7-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.4.3 1.7.2.4.3.7.6 1 .3.3.6.5 1 .6.3.1.6.3 1.7.3 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.4-.2 1.7-.3.4-.2.7-.3 1-.6.3-.3.5-.6.6-1 .1-.3.3-.6.3-1.7.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.4-.3-1.7-.2-.4-.3-.7-.6-1-.3-.3-.6-.5-1-.6-.3-.1-.6-.3-1.7-.3-1.2-.1-1.6-.1-4.7-.1Zm0 3.9a5.6 5.6 0 1 1 0 11.2 5.6 5.6 0 0 1 0-11.2Zm0 2.3a3.3 3.3 0 1 0 0 6.6 3.3 3.3 0 0 0 0-6.6Zm5.8-3.9a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6Z',
  tiktok:
    'M16.6 3c.4 2 1.7 3.5 3.7 3.8v3c-1.5 0-2.8-.5-3.9-1.3v6.1c0 3.5-2.6 6.4-6.2 6.4A6.2 6.2 0 0 1 4 14.8c0-3.5 2.8-6.3 6.3-6.3.3 0 .7 0 1 .1v3.2a3 3 0 0 0-1-.2 3.1 3.1 0 0 0-3.1 3.2c0 1.8 1.4 3.2 3.1 3.2 1.8 0 3.1-1.4 3.1-3.2V3h3.2Z',
  facebook:
    'M13.5 21v-7.5h2.5l.5-3h-3V8.6c0-.9.3-1.6 1.6-1.6H17V4.3c-.3 0-1.3-.1-2.4-.1-2.4 0-4.1 1.5-4.1 4.2v2.1H8v3h2.5V21h3Z',
  youtube:
    'M21.6 7.2c-.2-.9-.9-1.6-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8c.2.9.9 1.6 1.8 1.8 1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15.2V8.8L15.2 12 10 15.2Z',
};
---

<footer class="bg-ciruela-900 text-crema-100">
  <div class="contenedor grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
    <div>
      <div class="text-crema-50">
        <Logo />
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-crema-100/70">
        {SITE.tagline} Cursos 100% online con certificado, para aprender a tu ritmo y montar tu negocio de
        decoración.
      </p>
      <p class="mt-5 text-xs font-bold tracking-[0.18em] text-crema-100/50 uppercase">Ecosistema Sably</p>
      <a
        href={SITE.parent.url}
        rel="noopener"
        class="mt-2 inline-flex items-center gap-2 rounded-full border border-crema-100/20 px-4 py-2 text-sm font-semibold transition-colors hover:border-coral-300 hover:text-coral-200"
      >
        Powered by {SITE.parent.name}
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <div class="mt-5 flex gap-2.5">
        {
          Object.entries(SITE.social).map(([name, url]) => (
            <a
              href={url}
              rel="noopener"
              target="_blank"
              aria-label={name}
              class="flex h-9 w-9 items-center justify-center rounded-full bg-crema-100/10 transition-all duration-300 hover:-translate-y-0.5 hover:bg-coral-500"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={socialIcons[name]} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>

    <nav aria-label="Categorías">
      <p class="mb-4 text-xs font-bold tracking-[0.18em] text-crema-100/50 uppercase">Categorías</p>
      <ul class="space-y-2.5 text-sm">
        {
          topicLinks.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-coral-200">
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={`${base}/cursos/`} class="font-semibold text-coral-200 transition-colors hover:text-coral-100">
            Ver todos los cursos →
          </a>
        </li>
      </ul>
    </nav>

    <nav aria-label="Países">
      <p class="mb-4 text-xs font-bold tracking-[0.18em] text-crema-100/50 uppercase">Países</p>
      <ul class="grid grid-cols-2 gap-x-3 gap-y-2.5 text-sm">
        {
          COUNTRIES.map((c) => (
            <li>
              <a href={`/${c.code}/`} data-country-link={c.code} class="transition-colors hover:text-coral-200">
                {c.flag} {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Institucional">
      <p class="mb-4 text-xs font-bold tracking-[0.18em] text-crema-100/50 uppercase">Institucional</p>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/nosotros/" class="transition-colors hover:text-coral-200">Nosotros</a></li>
        <li><a href="/blog/" class="transition-colors hover:text-coral-200">Blog</a></li>
        <li><a href="/contacto/" class="transition-colors hover:text-coral-200">Contacto</a></li>
        <li><a href="/sitemap/" class="transition-colors hover:text-coral-200">Mapa del sitio</a></li>
        <li><a href="/legal/terminos/" class="transition-colors hover:text-coral-200">Términos y condiciones</a></li>
        <li><a href="/legal/privacidad/" class="transition-colors hover:text-coral-200">Política de privacidad</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-crema-100/10">
    <div class="contenedor flex flex-col items-center justify-between gap-3 py-6 text-xs text-crema-100/50 sm:flex-row">
      <p>© {new Date().getFullYear()} {SITE.name} · Una filial de Sably</p>
      <p class="flex flex-wrap items-center gap-x-2">
        <span>Certificado incluido ·</span>
        <span class="inline-flex items-center gap-1.5">
          Los cursos se imparten a través de
          <svg width="12" height="14" viewBox="0 0 24 28" fill="none" aria-hidden="true">
            <path
              d="M13.6 0.8c0.5 3.4-0.9 5.6-2.9 7.6C8.8 10.3 6.6 12.1 6.6 15.4a5.4 5.4 0 0 0 10.8 0.2c0-5.6-3.9-7.8-4.7-12.1-1.2 1.5-1.8 2.8-1.7 4.7-2-1.6-2.6-4.6-2-7.4"
              fill="#f04e23"></path>
          </svg>
          <span class="font-extrabold" style="color:#f04e23">Hotmart</span>
        </span>
      </p>
    </div>
  </div>
</footer>
