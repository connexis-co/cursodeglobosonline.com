---
interface Props {
  /** Tamaño del icono en px. */
  size?: number;
}
const { size = 38 } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <svg
    width={size}
    height={size}
    viewBox="0 0 44 44"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <radialGradient id="lg-coral" cx="0.35" cy="0.28" r="0.85">
        <stop offset="0%" stop-color="oklch(0.8 0.1 12)"></stop>
        <stop offset="100%" stop-color="oklch(0.55 0.2 15)"></stop>
      </radialGradient>
      <radialGradient id="lg-aqua" cx="0.35" cy="0.28" r="0.85">
        <stop offset="0%" stop-color="oklch(0.91 0.05 194)"></stop>
        <stop offset="100%" stop-color="oklch(0.72 0.1 195)"></stop>
      </radialGradient>
      <radialGradient id="lg-sol" cx="0.35" cy="0.28" r="0.85">
        <stop offset="0%" stop-color="oklch(0.95 0.06 90)"></stop>
        <stop offset="100%" stop-color="oklch(0.8 0.14 83)"></stop>
      </radialGradient>
    </defs>
    <!-- globo aqua (atrás izquierda) -->
    <ellipse cx="12" cy="18" rx="9" ry="10.5" fill="url(#lg-aqua)"></ellipse>
    <path d="M12 28.5 l-1.6 2.6 h3.2 Z" fill="oklch(0.72 0.1 195)"></path>
    <path d="M11.5 31 q-2 5 1 9" stroke="oklch(0.62 0.055 333)" stroke-width="1" fill="none" stroke-linecap="round"></path>
    <!-- globo sol (atrás derecha) -->
    <ellipse cx="33" cy="16" rx="8" ry="9.5" fill="url(#lg-sol)"></ellipse>
    <path d="M33 25.5 l-1.5 2.4 h3 Z" fill="oklch(0.8 0.14 83)"></path>
    <path d="M33.5 28 q2.4 5.5 -0.5 10.5" stroke="oklch(0.62 0.055 333)" stroke-width="1" fill="none" stroke-linecap="round"></path>
    <!-- globo coral (protagonista) -->
    <ellipse cx="22" cy="20" rx="10.5" ry="12.5" fill="url(#lg-coral)"></ellipse>
    <ellipse cx="18.2" cy="14.5" rx="3.4" ry="4.6" fill="white" opacity="0.35" transform="rotate(-18 18.2 14.5)"></ellipse>
    <path d="M22 32.5 l-1.9 3 h3.8 Z" fill="oklch(0.55 0.2 15)"></path>
    <path d="M22 35.5 q-2.8 4.5 0.5 8.5" stroke="oklch(0.42 0.06 331)" stroke-width="1.1" fill="none" stroke-linecap="round"></path>
  </svg>
  <span class="flex flex-col gap-[0.2rem] leading-none">
    <span class="font-display text-[1.05rem] font-semibold tracking-tight">Curso de Globos</span>
    <span class="flex items-center gap-1.5">
      <span class="text-[0.6rem] font-bold tracking-[0.28em] uppercase opacity-70">Online</span>
      <span class="inline-flex items-center gap-1" aria-label="by Sably">
        <span class="text-[0.55rem] lowercase opacity-60">by</span>
        <!-- Wordmark Sably (Surgena vectorizada): letras currentColor, punto coral de marca -->
        <svg viewBox="0 0 2916.1 1221" class="h-[0.62rem] w-auto opacity-90" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <g transform="translate(8.90,951.00) scale(1,-1)">
            <path transform="scale(1.7776)" d="M456 305H346Q346 341 317.0 363.0Q288 385 240 385Q201 385 175.5 368.5Q150 352 150 327Q150 302 175.0 283.5Q200 265 237.5 247.0Q275 229 318.5 209.0Q362 189 399.5 161.0Q437 133 462.0 94.0Q487 55 487 0H377Q377 37 352.0 61.5Q327 86 289.5 106.0Q252 126 208.5 144.5Q165 163 127.5 187.0Q90 211 65.0 244.5Q40 278 40 327Q40 362 55.5 392.0Q71 422 98.5 444.0Q126 466 163.5 478.0Q201 490 246 490Q293 490 331.5 476.5Q370 463 397.5 438.5Q425 414 440.5 380.0Q456 346 456 305Z" fill="currentColor"></path>
            <path transform="scale(1.7776)" d="M110 130Q140 130 160.0 110.0Q180 90 180 60Q180 30 160.0 10.0Q140 -10 110 -10Q80 -10 60.0 10.0Q40 30 40 60Q40 90 60.0 110.0Q80 130 110 130Z" fill="#E8456B"></path>
            <path transform="translate(901.22,0)" d="M410 235V300H520V168Q520 136 538.5 118.0Q557 100 590 100V-10Q544 -10 506.5 8.0Q469 26 446 58Q413 26 369.5 8.0Q326 -10 275 -10Q224 -10 179.0 9.0Q134 28 101.0 61.0Q68 94 49.0 139.0Q30 184 30 235Q30 287 49.0 331.5Q68 376 101.0 409.0Q134 442 179.0 461.0Q224 480 275 480H520V370H275Q247 370 222.5 359.5Q198 349 179.5 331.0Q161 313 150.5 288.5Q140 264 140 235Q140 207 150.5 182.0Q161 157 179.5 139.0Q198 121 222.5 110.5Q247 100 275 100Q304 100 328.5 110.5Q353 121 371.0 139.0Q389 157 399.5 182.0Q410 207 410 235Z" fill="currentColor"></path>
            <path transform="translate(1501.22,0)" d="M160 670V441Q190 464 226.0 477.0Q262 490 304 490Q354 490 397.0 471.0Q440 452 471.5 419.0Q503 386 521.5 341.0Q540 296 540 245Q540 193 521.0 148.5Q502 104 469.0 71.0Q436 38 391.0 19.0Q346 0 295 0H50V110H295Q323 110 347.5 120.5Q372 131 390.5 149.0Q409 167 419.5 192.0Q430 217 430 245Q430 274 419.5 298.5Q409 323 390.5 341.0Q372 359 347.5 369.5Q323 380 295 380Q266 380 241.5 369.5Q217 359 199.0 341.0Q181 323 170.5 298.5Q160 274 160 245V180H50V670Z" fill="currentColor"></path>
            <path transform="translate(2071.22,0)" d="M160 670V0H50V670Z" fill="currentColor"></path>
            <path transform="translate(2281.22,0)" d="M68 -80Q102 -80 128.0 -73.5Q154 -67 174.0 -52.5Q194 -38 210.5 -15.0Q227 8 241 42L266 100H171L10 480H129L278 129L427 480H546L345 7Q323 -46 296.0 -83.0Q269 -120 235.5 -144.0Q202 -168 160.5 -179.0Q119 -190 68 -190Z" fill="currentColor"></path>
          </g>
        </svg>
      </span>
    </span>
  </span>
</span>
