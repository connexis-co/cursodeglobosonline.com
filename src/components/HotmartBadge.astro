---
/**
 * Mención factual de la plataforma de pago, junto a los CTA de compra.
 * Términos de uso de Hotmart §5.2: no se puede usar su marca, logotipo o nombre comercial
 * para publicitar un producto ni sugerir que Hotmart lo asocia, aprueba o certifica.
 * Por eso NO se usa su logo ni su color de marca: solo texto neutro que informa dónde
 * se procesa el pago, con un icono propio de candado.
 */
import Icon from './Icon.astro';

interface Props {
  /** dark = para fondos oscuros. */
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 text-xs font-semibold',
    tone === 'dark' ? 'text-crema-100/80' : 'text-ciruela-600',
    className,
  ]}
>
  <Icon name="candado" size={14} class={tone === 'dark' ? 'text-crema-100/80' : 'text-ciruela-500'} />
  <span>Pago seguro procesado por Hotmart</span>
</span>
