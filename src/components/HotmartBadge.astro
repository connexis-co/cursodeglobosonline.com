---
/**
 * Sello "Pago seguro con Hotmart" — la llama de Hotmart simplificada + wordmark.
 * Se usa junto a los CTAs de compra para señal de confianza (§3.2 del plan).
 */
interface Props {
  /** dark = para fondos oscuros. */
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 text-xs font-bold',
    tone === 'dark' ? 'text-crema-100/80' : 'text-ciruela-500',
    className,
  ]}
>
  <span>Pago seguro con</span>
  <svg width="14" height="16" viewBox="0 0 24 28" fill="none" aria-hidden="true">
    <path
      d="M13.6 0.8c0.5 3.4-0.9 5.6-2.9 7.6C8.8 10.3 6.6 12.1 6.6 15.4a5.4 5.4 0 0 0 10.8 0.2c0-5.6-3.9-7.8-4.7-12.1-1.2 1.5-1.8 2.8-1.7 4.7-2-1.6-2.6-4.6-2-7.4"
      fill="#f04e23"></path>
    <path
      d="M12 27.4a7.4 7.4 0 0 1-7.4-7.4c0-4 2.6-6.2 4.4-8 1.5-1.5 2.7-3 2.9-5.4"
      stroke="#f04e23"
      stroke-width="1.6"
      fill="none"
      stroke-linecap="round"></path>
  </svg>
  <span class="font-extrabold" style="color:#f04e23">Hotmart</span>
</span>
