---
import type { CollectionEntry } from 'astro:content';
import { COUNTRIES, DEFAULT_COUNTRY, type Country } from '@/lib/countries';

interface Props {
  courses: CollectionEntry<'courses'>[];
  country?: Country;
}

const { courses, country } = Astro.props;
const c = country ?? COUNTRIES.find((x) => x.code === DEFAULT_COUNTRY)!;
---

<form
  id="lead-form"
  data-whatsapp={c.whatsapp}
  class="scroll-reveal relative overflow-hidden rounded-3xl border border-crema-200 bg-white p-6 shadow-globo sm:p-8"
>
  <p class="font-display text-2xl font-semibold text-ciruela-900">¿Tienes dudas antes de empezar?</p>
  <p class="mt-2 text-sm text-ciruela-500">
    Déjanos tus datos y te escribimos por WhatsApp con la información del curso que te interesa. Sin spam, sin
    llamadas raras.
  </p>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="mb-1.5 block text-xs font-bold text-ciruela-600">Nombre</span>
      <input type="text" name="nombre" required placeholder="¿Cómo te llamas?" class="field" />
    </label>
    <label class="block">
      <span class="mb-1.5 block text-xs font-bold text-ciruela-600">WhatsApp</span>
      <input type="tel" name="whatsapp" required placeholder={c.phoneDisplay} class="field" />
    </label>
    <label class="block sm:col-span-2">
      <span class="mb-1.5 block text-xs font-bold text-ciruela-600">Curso de interés</span>
      <select name="curso" class="field" required>
        {courses.map((course) => <option value={course.data.title}>{course.data.title}</option>)}
        <option value="Aún no sé">Aún no sé, quiero asesoría</option>
      </select>
    </label>
  </div>

  <button
    type="submit"
    class="mt-6 w-full rounded-xl bg-coral-500 px-6 py-4 text-sm font-bold text-white shadow-boton transition-all duration-300 ease-fiesta hover:-translate-y-0.5 hover:bg-coral-600 sm:w-auto"
  >
    Quiero información
  </button>
  <p class="mt-3 text-[0.7rem] text-ciruela-400">
    Al enviar aceptas nuestra <a href="/legal/privacidad/" class="underline">política de privacidad</a>. Tus datos
    solo se usan para responderte.
  </p>
</form>

<script>
  import { trackEvent } from '@/lib/analytics';

  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const nombre = String(data.get('nombre') ?? '');
    const curso = String(data.get('curso') ?? '');
    const tel = String(data.get('whatsapp') ?? '');
    trackEvent('generate_lead', {
      form_name: 'lead_form',
      course_interest: curso,
      country: document.body.dataset.country ?? '',
    });
    const msg = `Hola 🎈 Soy ${nombre}. Me interesa el ${curso} y quiero más información. Mi WhatsApp es ${tel}.`;
    window.open(
      `https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(msg)}`,
      '_blank',
      'noopener',
    );
    form.reset();
  });
</script>

<style>
  .field {
    width: 100%;
    border-radius: 1rem;
    border: 1px solid var(--color-crema-300);
    background: var(--color-crema-50);
    padding: 0.8rem 1rem;
    font-size: 0.95rem;
    color: var(--color-ciruela-800);
    outline: none;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .field:focus {
    border-color: var(--color-coral-400);
    box-shadow: 0 0 0 3px oklch(0.62 0.2 14 / 0.15);
  }
  .field::placeholder {
    color: var(--color-ciruela-300);
  }
</style>
