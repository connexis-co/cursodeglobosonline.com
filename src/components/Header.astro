---
import Logo from './Logo.astro';
import { COUNTRIES, DEFAULT_COUNTRY, type Country } from '@/lib/countries';
import { CATEGORIES } from '@/lib/categories';

interface Props {
  country?: Country;
  pathAfterCountry?: string;
  transparent?: boolean;
}

const { country, pathAfterCountry = '/', transparent = false } = Astro.props;
const cc = country?.code ?? DEFAULT_COUNTRY;
const base = `/${cc}`;
const current = country ?? COUNTRIES.find((c) => c.code === DEFAULT_COUNTRY)!;
---

<header
  id="site-header"
  data-transparent={transparent ? 'true' : undefined}
  class:list={[
    'fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,box-shadow] duration-300',
    transparent
      ? 'border-b border-transparent text-crema-50'
      : 'border-b border-crema-200 bg-crema-50/92 text-ciruela-800 backdrop-blur-md',
  ]}
>
  <div class="contenedor flex h-16 items-center justify-between gap-4 lg:h-18">
    <a href={country ? `${base}/` : '/'} class="shrink-0" aria-label="Curso de Globos Online — inicio">
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      <a href={`${base}/cursos/`} class="nav-link">Cursos</a>
      <details class="nav-dropdown group relative">
        <summary class="nav-link flex cursor-pointer list-none items-center gap-1">
          Categorías
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="transition-transform group-open:rotate-180" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <div
          class="absolute left-0 top-full mt-2 w-80 rounded-2xl border border-crema-200 bg-crema-50 p-2 text-ciruela-800 shadow-tarjeta"
        >
          {
            CATEGORIES.map((cat) => (
              <a
                href={`${base}/cursos/${cat.slug}/`}
                class="flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-coral-50"
              >
                <span class="text-xl" aria-hidden="true">
                  {cat.emoji}
                </span>
                <span>
                  <span class="block font-bold">{cat.name}</span>
                  <span class="mt-0.5 line-clamp-2 block text-xs text-ciruela-500">{cat.short}</span>
                </span>
              </a>
            ))
          }
        </div>
      </details>
      <a href="/blog/" class="nav-link">Blog</a>
      <a href="/nosotros/" class="nav-link">Nosotros</a>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <details class="nav-dropdown group relative">
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-current/20 px-3 py-1.5 text-sm font-semibold transition-colors hover:border-current/40"
          aria-label={`País actual: ${current.name}. Cambiar país`}
        >
          <span aria-hidden="true">{current.flag}</span>
          <span class="uppercase">{current.code}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="transition-transform group-open:rotate-180" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 top-full mt-2 w-60 rounded-2xl border border-crema-200 bg-crema-50 p-2 text-ciruela-800 shadow-tarjeta"
        >
          {
            COUNTRIES.map((c) => (
              <a
                href={`/${c.code}${pathAfterCountry}`}
                data-country-link={c.code}
                class:list={[
                  'flex items-center gap-2.5 rounded-xl px-3 py-2 text-sm transition-colors hover:bg-coral-50',
                  c.code === cc && 'bg-crema-100 font-bold',
                ]}
              >
                <span aria-hidden="true">{c.flag}</span>
                <span class="flex-1">{c.name}</span>
                <span class="text-xs text-ciruela-400">{c.currency}</span>
              </a>
            ))
          }
        </div>
      </details>
      <a
        href={`${base}/cursos/`}
        class="rounded-full bg-coral-500 px-5 py-2.5 text-sm font-extrabold tracking-wide text-white uppercase shadow-cta transition-all duration-300 ease-fiesta hover:-translate-y-0.5 hover:bg-coral-600"
      >
        Ver cursos
      </a>
    </div>

    <button
      id="menu-open"
      class="flex h-11 w-11 items-center justify-center rounded-full transition-colors hover:bg-current/10 lg:hidden"
      aria-label="Abrir menú"
      aria-haspopup="dialog"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Menú mobile full-page (patrón aprende.com, portado del ecosistema Sably) -->
<dialog
  id="mobile-menu"
  class="m-0 h-dvh max-h-dvh w-full max-w-full bg-crema-50 text-ciruela-800 backdrop:bg-ciruela-900/40"
>
  <div class="flex h-full flex-col">
    <div class="contenedor flex h-16 shrink-0 items-center justify-between">
      <Logo size={32} />
      <button
        id="menu-close"
        class="flex h-11 w-11 items-center justify-center rounded-full transition-colors hover:bg-crema-200"
        aria-label="Cerrar menú"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <div class="contenedor flex-1 overflow-y-auto pb-10">
      <form action={`${base}/cursos/`} method="get" class="menu-item mb-6" style="--i: 0" role="search">
        <label class="flex items-center gap-3 rounded-2xl border border-crema-300 bg-white px-4 py-3">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="shrink-0 text-ciruela-400" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
            <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <input
            type="search"
            name="q"
            placeholder="Buscar cursos…"
            class="w-full bg-transparent text-base outline-none placeholder:text-ciruela-300"
          />
        </label>
      </form>

      <nav class="flex flex-col" aria-label="Menú móvil">
        <a href={`${base}/cursos/`} class="menu-item menu-row" style="--i: 1">📚 Todos los cursos</a>
        {
          CATEGORIES.map((cat, i) => (
            <a href={`${base}/cursos/${cat.slug}/`} class="menu-item menu-row" style={`--i: ${i + 2}`}>
              {cat.emoji} {cat.name}
            </a>
          ))
        }
        <a href="/blog/" class="menu-item menu-row" style="--i: 5">📝 Blog</a>
        <a href="/nosotros/" class="menu-item menu-row" style="--i: 6">👋 Nosotros</a>
        <a href="/contacto/" class="menu-item menu-row" style="--i: 7">📞 Contacto</a>
      </nav>

      <div class="menu-item mt-6 border-t border-crema-200 pt-6" style="--i: 8">
        <p class="mb-3 text-xs font-bold tracking-[0.18em] text-ciruela-400 uppercase">🌎 Cambiar país</p>
        <div class="grid grid-cols-2 gap-2">
          {
            COUNTRIES.map((c) => (
              <a
                href={`/${c.code}${pathAfterCountry}`}
                data-country-link={c.code}
                class:list={[
                  'flex items-center gap-2 rounded-xl border px-3 py-2.5 text-sm transition-colors',
                  c.code === cc
                    ? 'border-coral-300 bg-coral-50 font-bold'
                    : 'border-crema-200 bg-white hover:border-coral-200',
                ]}
              >
                <span aria-hidden="true">{c.flag}</span>
                <span>{c.name}</span>
              </a>
            ))
          }
        </div>
      </div>

      <a
        href={`${base}/cursos/`}
        class="menu-item mt-8 block rounded-full bg-coral-500 px-6 py-4 text-center text-sm font-extrabold tracking-wide text-white uppercase shadow-cta"
        style="--i: 9"
      >
        Ver todos los cursos
      </a>
    </div>
  </div>
</dialog>

<style>
  .nav-link {
    padding: 0.5rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 700;
    transition: background-color 0.25s ease;
  }
  .nav-link:hover {
    background-color: color-mix(in oklch, currentColor 10%, transparent);
  }
  .menu-row {
    display: block;
    padding: 0.9rem 0.25rem;
    font-size: 1.15rem;
    font-weight: 700;
    border-bottom: 1px solid var(--color-crema-200);
  }
  /* Entrada escalonada de los items al abrir el menú */
  #mobile-menu .menu-item {
    opacity: 0;
    transform: translateY(14px);
  }
  #mobile-menu[open] .menu-item {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.4s var(--ease-suave),
      transform 0.4s var(--ease-suave);
    transition-delay: calc(var(--i) * 45ms);
  }
  /* Header transparente → sólido al hacer scroll */
  #site-header.is-scrolled {
    background-color: color-mix(in oklch, var(--color-crema-50) 92%, transparent);
    border-color: var(--color-crema-200);
    color: var(--color-ciruela-800);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 20px -8px oklch(0.3 0.05 330 / 0.12);
  }
</style>

<script>
  import { trackEvent } from '@/lib/analytics';

  const header = document.getElementById('site-header');
  if (header?.dataset.transparent) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 32);
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });
  }

  const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  document.getElementById('menu-open')?.addEventListener('click', () => {
    menu?.showModal();
    document.body.style.overflow = 'hidden';
  });
  const closeMenu = () => {
    menu?.close();
  };
  document.getElementById('menu-close')?.addEventListener('click', closeMenu);
  menu?.addEventListener('close', () => {
    document.body.style.overflow = '';
  });
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) closeMenu();
  });

  // Cerrar dropdowns <details> al hacer click fuera
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });

  // Selección de país: persistir + evento select_country (§10)
  document.querySelectorAll<HTMLAnchorElement>('[data-country-link]').forEach((link) => {
    link.addEventListener('click', () => {
      const to = link.dataset.countryLink ?? '';
      const from = document.body.dataset.country ?? 'none';
      localStorage.setItem('cdgo-country', to);
      trackEvent('select_country', { country_from: from, country_to: to });
    });
  });
</script>
