---
interface Props {
  rating: number;
  count?: number;
  class?: string;
}
const { rating, count, class: className } = Astro.props;
const stars = [1, 2, 3, 4, 5];
---

<span class:list={['inline-flex items-center gap-1.5', className]}>
  <span class="flex gap-0.5" role="img" aria-label={`Calificación ${rating} de 5`}>
    {
      stars.map((s) => (
        <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9Z"
            fill={s <= Math.round(rating) ? 'oklch(0.84 0.145 85)' : 'oklch(0.9 0.022 78)'}
            stroke="oklch(0.62 0.12 70)"
            stroke-width="1"
          />
        </svg>
      ))
    }
  </span>
  <span class="text-sm font-bold">{rating.toFixed(1)}</span>
  {count && <span class="text-xs text-ciruela-400">({count})</span>}
</span>
