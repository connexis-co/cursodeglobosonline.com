---
/**
 * Globos decorativos animados (CSS puro, patrón lbdballoons.com):
 *  · animación `floating` (0→25px→0, ~3s ease-in-out) con delays NEGATIVOS
 *    y duraciones ligeramente distintas → desincronización natural.
 *  · globos XL que sangran fuera de la sección (como .globo--v1..v9 de LBD,
 *    que usa imágenes de 536×590 recortadas por el borde).
 *  · parallax sutil al scroll vía wrapper .globo-plx (animation-timeline nativo).
 *
 * variants: "hero" · "rise" · "corner-left" · "corner-right"
 */
interface Props {
  variant?: 'hero' | 'rise' | 'corner-left' | 'corner-right';
}
const { variant = 'hero' } = Astro.props;

interface Globo {
  color: string;
  light: string;
  dark: string;
  size: number;
  left?: string;
  right?: string;
  top?: string;
  bottom?: string;
  delay: string;
  duration: string;
  opacity?: number;
  /** Distancia de parallax al scroll (px, positivo = baja). */
  plx?: number;
  rise?: boolean;
  /** Globo XL sangrante: se oculta en móvil para no tapar el contenido. */
  xl?: boolean;
}

/** [base, luz, sombra] — la sombra del borde inferior da el volumen del látex real. */
const PALETA = {
  coral: ['oklch(0.62 0.2 14)', 'oklch(0.85 0.09 20)', 'oklch(0.54 0.17 25)'],
  aqua: ['oklch(0.78 0.1 193)', 'oklch(0.92 0.05 194)', 'oklch(0.63 0.1 199)'],
  sol: ['oklch(0.84 0.145 85)', 'oklch(0.95 0.07 89)', 'oklch(0.69 0.13 79)'],
  lila: ['oklch(0.74 0.1 303)', 'oklch(0.9 0.05 304)', 'oklch(0.59 0.11 302)'],
  dorado: ['oklch(0.76 0.12 75)', 'oklch(0.9 0.07 79)', 'oklch(0.61 0.11 72)'],
} as const;

const g = (
  tone: keyof typeof PALETA,
  size: number,
  pos: Partial<Globo>,
  delay: string,
  duration = '3s',
  opacity = 1,
): Globo => ({
  color: PALETA[tone][0],
  light: PALETA[tone][1],
  dark: PALETA[tone][2],
  size,
  delay,
  duration,
  opacity,
  ...pos,
});

const VARIANTS: Record<string, Globo[]> = {
  hero: [
    // XL sangrando fuera de la sección (delays negativos exactos de LBD: 0/-0.3/-0.6/-1)
    { ...g('coral', 320, { left: '-110px', top: '-70px', plx: 110 }, '0s', '3s', 0.95), xl: true },
    { ...g('sol', 250, { right: '-85px', top: '26%', plx: 70 }, '-1s', '3.6s', 0.95), xl: true },
    g('aqua', 96, { left: '10%', top: '56%', plx: 140 }, '-0.3s', '3.3s', 0.9),
    g('lila', 62, { right: '17%', top: '66%', plx: 90 }, '-0.6s', '3.8s', 0.8),
    g('dorado', 44, { left: '26%', top: '24%', plx: 55 }, '-1.4s', '4.1s', 0.55),
    g('coral', 36, { right: '31%', top: '15%', plx: 40 }, '-2s', '3.5s', 0.5),
  ],
  'corner-left': [{ ...g('aqua', 230, { left: '-80px', bottom: '-90px', plx: -60 }, '-0.6s', '3.4s', 0.92), xl: true }],
  'corner-right': [{ ...g('lila', 240, { right: '-85px', top: '-80px', plx: 80 }, '-0.3s', '3.2s', 0.92), xl: true }],
  rise: [
    { ...g('coral', 34, { left: '8%' }, '0s', '16s', 0.6), rise: true },
    { ...g('aqua', 26, { left: '28%' }, '4s', '19s', 0.5), rise: true },
    { ...g('sol', 30, { left: '52%' }, '8s', '17s', 0.55), rise: true },
    { ...g('lila', 24, { left: '72%' }, '2s', '20s', 0.45), rise: true },
    { ...g('coral', 28, { left: '88%' }, '6s', '18s', 0.5), rise: true },
  ],
};

const globos = VARIANTS[variant];
let uid = 0;
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  {
    globos.map((b) => {
      uid += 1;
      const gradId = `bg-${variant}-${uid}-${b.size}`;
      const pos = `${b.left ? `left:${b.left};` : ''}${b.right ? `right:${b.right};` : ''}${
        b.top ? `top:${b.top};` : b.rise ? 'top:100%;' : ''
      }${b.bottom ? `bottom:${b.bottom};` : ''}`;
      return (
        <div
          class:list={[b.rise ? '' : 'globo-plx', b.xl && 'hidden sm:block']}
          style={`position:absolute;${pos}width:${b.size}px;height:${Math.round(b.size * 1.55)}px;${
            b.plx !== undefined ? `--plx:${b.plx}px;` : ''
          }`}
        >
          <svg
            class={b.rise ? 'animate-balloon-rise' : 'animate-floating'}
            style={`width:100%;height:100%;animation-delay:${b.delay};animation-duration:${b.duration};opacity:${b.opacity ?? 1}`}
            viewBox="0 0 40 62"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              {/* Volumen de látex real: luz arriba-izq, base, y sombra en el borde (AO) */}
              <radialGradient id={gradId} cx="0.36" cy="0.26" r="0.95">
                <stop offset="0%" stop-color={b.light} />
                <stop offset="52%" stop-color={b.color} />
                <stop offset="100%" stop-color={b.dark} />
              </radialGradient>
              <radialGradient id={`${gradId}-sheen`} cx="0.5" cy="0.5" r="0.5">
                <stop offset="0%" stop-color="white" stop-opacity="0.55" />
                <stop offset="70%" stop-color="white" stop-opacity="0.18" />
                <stop offset="100%" stop-color="white" stop-opacity="0" />
              </radialGradient>
            </defs>
            {/* cuerpo en lágrima (más ancho arriba, afinando hacia el nudo) */}
            <path
              d="M20 1.5 C30.5 1.5 38.5 10 38.5 21 C38.5 30.5 31.5 39.5 23.5 42.7 L20 43.6 L16.5 42.7 C8.5 39.5 1.5 30.5 1.5 21 C1.5 10 9.5 1.5 20 1.5 Z"
              fill={`url(#${gradId})`}
            />
            {/* brillo satinado amplio (patrón del látex real de LBD) */}
            <ellipse
              cx="13.5"
              cy="13"
              rx="7.5"
              ry="11"
              fill={`url(#${gradId}-sheen)`}
              transform="rotate(-20 13.5 13)"
            />
            {/* reflejo secundario sutil al lado derecho */}
            <ellipse cx="30" cy="22" rx="2.6" ry="7" fill="white" opacity="0.12" transform="rotate(14 30 22)" />
            {/* nudo de látex con pestaña */}
            <path d="M20 43 c-2.6 1.6 -3.6 3.2 -3 4.8 h6 c0.6 -1.6 -0.4 -3.2 -3 -4.8 Z" fill={b.dark} />
            <ellipse cx="20" cy="47.6" rx="3.1" ry="1.1" fill={b.dark} opacity="0.85" />
            <path
              d="M20 48.5 q-4 7 0.5 12 q 3.5 4.5 -1 6.5"
              stroke={b.dark}
              stroke-opacity="0.55"
              stroke-width="1.3"
              fill="none"
              stroke-linecap="round"
            />
          </svg>
        </div>
      );
    })
  }
</div>
