---
/**
 * Mockup del certificado dibujado en CSS/HTML (sin imágenes falsas).
 * TODO(JP): reemplazar por foto/scan real del certificado Hotmart cuando esté.
 */
interface Props {
  courseName?: string;
}
const { courseName = 'Curso de Decoración con Globos' } = Astro.props;
---

<div class="cert-wrap relative mx-auto max-w-md" aria-hidden="true">
  <div
    class="cert scroll-reveal-late relative rotate-[-2.5deg] rounded-2xl border-4 border-dorado-300 bg-white p-8 shadow-globo"
  >
    <div class="rounded-xl border border-dorado-300/60 px-6 py-8 text-center">
      <p class="text-[0.6rem] font-bold tracking-[0.3em] text-dorado-700 uppercase">Certificado digital</p>
      <p class="mt-3 font-display text-2xl font-semibold text-ciruela-900">Certificado de finalización</p>
      <p class="mt-4 text-xs text-ciruela-400">Se otorga a</p>
      <p class="mx-8 mt-1 border-b-2 border-dotted border-crema-300 pb-1 font-display text-lg text-ciruela-600 italic">
        Tu nombre completo
      </p>
      <p class="mt-4 text-xs leading-relaxed text-ciruela-500">
        por completar el 100% de las lecciones del<br />
        <strong class="text-ciruela-800">{courseName}</strong>
      </p>
      <div class="mt-6 flex items-center justify-center gap-6">
        <span class="flex h-14 w-14 items-center justify-center rounded-full bg-dorado-300/30">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="10" r="6" fill="oklch(0.76 0.12 75)"></circle>
            <path d="M9 15.5 7.5 21l4.5-2 4.5 2-1.5-5.5" fill="oklch(0.76 0.12 75)" opacity="0.7"></path>
            <path d="m9.6 10 1.7 1.7 3.1-3.4" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
          </svg>
        </span>
        <span class="text-left text-[0.55rem] leading-tight text-ciruela-400">
          Emitido y verificable<br />en línea vía <strong>Hotmart</strong><br />con código único
        </span>
      </div>
    </div>
  </div>
  <!-- globo que asoma detrás del certificado -->
  <svg
    class="animate-balloon-float absolute -top-9 -right-7 -z-10 h-24 w-16"
    style="animation-duration: 6s"
    viewBox="0 0 40 62"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <ellipse cx="20" cy="19" rx="17" ry="19" fill="oklch(0.84 0.145 85)"></ellipse>
    <ellipse cx="14" cy="11" rx="5" ry="7" fill="white" opacity="0.32" transform="rotate(-16 14 11)"></ellipse>
    <path d="M20 38 l-2.6 4 h5.2 Z" fill="oklch(0.84 0.145 85)"></path>
    <path d="M20 42.5 q-4 7 0.5 13" stroke="oklch(0.62 0.12 70)" stroke-opacity="0.5" stroke-width="1.3" fill="none" stroke-linecap="round"></path>
  </svg>
</div>

<style>
  .cert {
    transition: transform 0.5s var(--ease-fiesta);
  }
  .cert-wrap:hover .cert {
    transform: rotate(-0.5deg) scale(1.02);
  }
</style>
