---
import type { Post } from '@/lib/blog';
import { formatDate, lastModified, postUrl, readingMinutes } from '@/lib/blog';
import { getBlogCluster } from '@/lib/emdash-content';

interface Props {
  post: Post;
  /** Tarjeta horizontal grande (destacado del índice). */
  featured?: boolean;
  /** La imagen de la primera tarjeta visible puede ser el LCP. */
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { post, featured = false, eager = false, headingLevel = 'h3' } = Astro.props;
const d = post.data;
const cluster = await getBlogCluster(d.cluster);
const Heading = headingLevel;
---

<article
  class:list={[
    'post-card group relative flex overflow-hidden rounded-3xl border border-crema-200 bg-white shadow-tarjeta',
    featured ? 'flex-col md:flex-row' : 'flex-col',
  ]}
>
  <div class:list={['relative overflow-hidden', featured ? 'aspect-[16/9] md:aspect-auto md:w-[56%]' : 'aspect-[16/9]']}>
    <img
      src={d.hero.src}
      width={d.hero.width}
      height={d.hero.height}
      alt={d.heroAlt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="h-full w-full object-cover transition-transform duration-700 ease-suave group-hover:scale-[1.04]"
    />
    {
      d.isPillar && (
        <span class="absolute top-3 left-3 rounded-full bg-ciruela-900/85 px-3 py-1 text-[0.7rem] font-extrabold tracking-wide text-white backdrop-blur-sm">
          Guía completa
        </span>
      )
    }
  </div>
  <div class:list={['flex flex-1 flex-col gap-2.5', featured ? 'p-6 md:p-8 md:justify-center' : 'p-5']}>
    <p class="text-[0.7rem] font-extrabold tracking-[0.18em] text-coral-600 uppercase">{cluster.name}</p>
    <Heading class:list={['font-display font-semibold text-ciruela-900', featured ? 'text-2xl md:text-3xl' : 'text-lg']}>
      <a href={postUrl(post)} class="after:absolute after:inset-0 focus-visible:outline-none">
        {d.title}
      </a>
    </Heading>
    <p class:list={['text-sm leading-relaxed text-ciruela-500', featured ? 'line-clamp-3' : 'line-clamp-2']}>
      {d.description}
    </p>
    <p class="mt-auto pt-1 text-xs text-ciruela-400">
      <time datetime={lastModified(post).toISOString()}>{formatDate(lastModified(post))}</time>
      · {readingMinutes(post)} min de lectura
    </p>
  </div>
</article>

<style>
  .post-card {
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.4s ease;
  }
  .post-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-globo);
  }
  .post-card:has(a:focus-visible) {
    outline: 3px solid var(--color-coral-400);
    outline-offset: 3px;
  }
</style>
