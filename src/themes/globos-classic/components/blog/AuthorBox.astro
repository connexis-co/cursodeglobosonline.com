---
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import type { Author } from '@/lib/authors';

interface Props {
  author: Author;
}
const { author } = Astro.props;
const initials = author.type === 'Organization' ? 'CG' : author.name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---

<section class="flex gap-4 rounded-3xl border border-crema-200 bg-crema-100 p-6" aria-label="Sobre el autor">
  {
    author.photo ? (
      <ResponsiveImage sizes="64px" maxWidth={160} src={author.photo} alt={author.name} width="64" height="64" loading="lazy" class="h-16 w-16 shrink-0 rounded-full object-cover" />
    ) : (
      <span
        class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-ciruela-900 font-display text-lg font-semibold text-white"
        aria-hidden="true"
      >
        {initials}
      </span>
    )
  }
  <div>
    <p class="text-xs font-extrabold tracking-[0.16em] text-ciruela-400 uppercase">Escrito por</p>
    <p class="mt-0.5 font-display text-lg font-semibold text-ciruela-900">
      <a href={`/blog/autor/${author.slug}/`} rel="author" class="hover:text-coral-600">{author.name}</a>
    </p>
    {author.jobTitle && <p class="text-sm text-ciruela-500">{author.jobTitle}</p>}
    <p class="mt-2 text-sm leading-relaxed text-ciruela-500">{author.bio}</p>
  </div>
</section>
