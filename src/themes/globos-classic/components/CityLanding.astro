---
import { sortCourses } from '@/lib/course-order';
import { getCollection } from '@/lib/emdash-content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Balloons from '@/components/Balloons.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CourseCard from '@/components/CourseCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import Icon from '@/components/Icon.astro';
import type { Country, City } from '@/lib/countries';
import { getCityLocal } from '@/lib/emdash-content';
import { breadcrumbSchema, faqSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';
import { GENERAL_COURSE } from '@/lib/course-order';

interface Props {
  country: Country;
  city: City;
}

const { country, city } = Astro.props;
const cityLocal = await getCityLocal(city.slug);

const courses = sortCourses(await getCollection('courses'));
// Reseñas reales de Hotmart (no existen reseñas por ciudad: no se inventan).
const testimonials = (await getCollection('testimonials')).slice(0, 3);

const faqs = [
  ...(cityLocal?.faqs ?? []),
  {
    q: `¿Los cursos son presenciales en ${city.name}?`,
    a: `Son 100% online, y esa es la ventaja: estudias desde cualquier punto de ${city.name} a tu ritmo, sin traslados, y repites cada técnica las veces que quieras antes de un evento real.`,
  },
  {
    q: `¿Cómo pago desde ${country.name}?`,
    a: `En Hotmart, con tarjetas y métodos locales de ${country.name}; el precio se muestra en ${country.currency} antes de confirmar. El acceso llega a tu correo al instante.`,
  },
];

// Intención de la URL: «cursos de globos en {ciudad}» (plural, entrada local). El singular
// «curso de decoración con globos» es de la ficha del curso general y «curso de globoflexia» de
// la suya: esta página las enlaza con ese texto exacto en lugar de competir por ellas.
const generalCourse = courses.find((c) => c.id === GENERAL_COURSE);
let title = `Cursos de Globos en ${city.name}: Online y con Certificado`;
if (title.length > 60) title = `Cursos de Globos en ${city.name}: 100% Online`;
const description = `Cursos de globos para estudiar desde ${city.name}, sin traslados: decoración, globoflexia, bouquets, flores y burbuja. Certificado y pago en ${country.currency}.`;
---

<BaseLayout
  {title}
  {description}
  {country}
  pathAfterCountry="/"
  schemas={[
    faqSchema(faqs),
    breadcrumbSchema([
      { name: 'Inicio', url: `${SITE.url}/${country.code}/` },
      { name: city.name, url: `${SITE.url}/${country.code}/${city.slug}/` },
    ]),
  ]}
  pageType="city_home"
>
  <section class="relative overflow-hidden bg-crema-100 pt-6 lg:pt-8">
    <Balloons variant="corner-right" />
    <div class="contenedor relative pb-12 lg:pb-16">
      <nav class="mb-4 text-xs text-ciruela-500 lg:mb-8" aria-label="Miga de pan">
        <a href={`/${country.code}/`} class="inline-block py-1 hover:text-coral-600 lg:py-0">{country.flag} {country.name}</a>
        <span aria-hidden="true"> / </span>
        <span class="font-bold text-ciruela-600">{city.name}</span>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-xs font-extrabold text-ciruela-700 shadow-tarjeta">
          {country.flag} {city.name}, {country.name}
        </span>
        <h1 class="mt-4 text-3xl font-semibold text-balance text-ciruela-900 sm:text-4xl lg:text-5xl">
          Cursos de decoración con globos en {city.name}
        </h1>
        {cityLocal && <p class="mt-5 max-w-2xl leading-relaxed text-ciruela-600">{cityLocal.hook}</p>}
        <!-- Enlaces contextuales a las fichas (anti-canibalización): el texto ancla exacto apunta
             a la URL que debe posicionar por esa búsqueda, no a la home del país. -->
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ciruela-600">
          Desde {city.name} tomas el mismo{' '}
          <a
            href={`/${country.code}/${GENERAL_COURSE}/`}
            class="font-bold text-coral-700 underline decoration-coral-200 decoration-2 underline-offset-[3px] transition-colors hover:decoration-coral-500"
            >curso de decoración con globos</a
          >{' '}
          y el mismo{' '}
          <a
            href={`/${country.code}/curso-de-globoflexia/`}
            class="font-bold text-coral-700 underline decoration-coral-200 decoration-2 underline-offset-[3px] transition-colors hover:decoration-coral-500"
            >curso de globoflexia</a
          >{' '}
          que en el resto de {country.name}: mismas clases, certificado y pago en {country.currency}.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="#cursos-ciudad"
            class="rounded-xl bg-coral-600 px-7 py-3.5 text-sm font-bold text-white shadow-boton transition-all duration-300 ease-fiesta hover:-translate-y-0.5 hover:bg-coral-700"
          >
            Ver los cursos
          </a>
          <ul class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs font-semibold text-ciruela-600">
            <li class="inline-flex items-center gap-1.5">
              <Icon name="birrete" class="text-coral-600" />Certificado incluido
            </li>
            <li class="inline-flex items-center gap-1.5">
              <Icon name="infinito" class="text-coral-600" />Acceso de por vida
            </li>
            <li class="inline-flex items-center gap-1.5">
              <Icon name="escudo" class="text-aqua-700" />Garantía 7 días
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="cursos-ciudad" class="contenedor scroll-mt-24 py-14 lg:py-16">
    <SectionHeading
      eyebrow={`Disponibles en ${city.name}`}
      title={`Cursos de globos disponibles en ${city.name}`}
      lead={`Los ${courses.length} cursos se estudian 100% online desde ${city.name}, con pago en ${country.currency}${generalCourse ? '. Si empiezas de cero, el de decoración con globos es la base' : ''}.`}
    />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        courses.map((course, i) => (
          <div class="scroll-reveal" style={`animation-delay:${i * 60}ms`}>
            <CourseCard {course} {country} class="h-full" />
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-crema-100 py-14">
    <div class="contenedor">
      <SectionHeading
        eyebrow="Reseñas reales"
        title="Lo que escriben las alumnas en Hotmart"
        lead="Citas textuales de la ficha pública de cada curso en Hotmart, la plataforma donde se compra y se estudia."
      />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          testimonials.map((t, i) => (
            <div class="scroll-reveal" style={`animation-delay:${i * 60}ms`}>
              <TestimonialCard testimonial={t} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="contenedor max-w-4xl py-14">
    <SectionHeading
      eyebrow="Preguntas frecuentes"
      title={`Dudas frecuentes desde ${city.name}`}
      align="center"
    />
    <div class="mt-8">
      <FaqAccordion faqs={faqs} />
    </div>
  </section>

  <section class="contenedor pb-16">
    <div class="rounded-[2rem] border border-crema-200 bg-crema-100 p-8">
      <p class="text-xs font-bold tracking-[0.18em] text-ciruela-500 uppercase">
        También estamos en otras ciudades de {country.name}
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          country.cities
            .filter((c) => c.slug !== city.slug)
            .map((c) => (
              <a
                href={`/${country.code}/${c.slug}/`}
                class="rounded-full border border-crema-300 bg-white px-3.5 py-2.5 text-xs font-bold text-ciruela-600 transition-colors hover:border-coral-300 hover:text-coral-600"
              >
                {c.name}
              </a>
            ))
        }
        <a
          href={`/${country.code}/`}
          class="inline-flex items-center gap-1 rounded-full bg-coral-600 px-3.5 py-2.5 text-xs font-extrabold text-white transition-colors hover:bg-coral-700"
        >
          Todo {country.name} <Icon name="flecha" size={14} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
