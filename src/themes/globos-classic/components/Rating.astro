---
/**
 * Estrellas de solo lectura con relleno fraccionario (4,4 → cuatro llenas y el 40 % de la
 * quinta). Para votar, ver StarRating.astro.
 */
import { formatAverage } from '@/lib/ratings-config';

interface Props {
  rating: number;
  count?: number;
  /** Lado de cada estrella en px. */
  size?: number;
  /** `dark`: sobre fondo ciruela (landings de Ads). */
  tone?: 'light' | 'dark';
  class?: string;
}
const { rating, count, size = 14, tone = 'light', class: className } = Astro.props;
const STAR = 'M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4 6.1 20.5l1.2-6.5L2.5 9.4l6.6-.9Z';
const GAP = 2;
const width = size * 5 + GAP * 4;
const whole = Math.floor(rating);
const filled = Math.min(width, whole * (size + GAP) + (rating - whole) * size);
---

<span class:list={['inline-flex items-center gap-1.5', className]}>
  <span
    class="relative inline-block shrink-0"
    style={`width:${width}px;height:${size}px`}
    role="img"
    data-rating-image
    data-star-size={size}
    aria-label={count === 0 ? 'Aún sin votos' : `Calificación ${formatAverage(rating)} de 5`}
  >
    {
      [false, true].map((full) => (
        <span
          class="absolute inset-y-0 left-0 flex overflow-hidden"
          style={`gap:${GAP}px;width:${full ? filled.toFixed(1) : width}px`}
          aria-hidden="true"
          data-rating-fill={full||undefined}
        >
          {[1, 2, 3, 4, 5].map(() => (
            <svg class="shrink-0" style="max-width:none" width={size} height={size} viewBox="0 0 24 24">
              <path
                d={STAR}
                fill={full ? 'oklch(0.84 0.145 85)' : 'oklch(0.9 0.022 78)'}
                stroke="oklch(0.62 0.12 70)"
                stroke-width="1"
              />
            </svg>
          ))}
        </span>
      ))
    }
  </span>
  <span class="text-sm font-bold" data-rating-value>{count === 0 ? 'Aún sin votos' : formatAverage(rating)}</span>
  {/* ciruela-500: AA también sobre crema-100 (ciruela-400 da 4.45:1 ahí). `count > 0` evita pintar un «0». */}
  {
    count != null && (
      <span data-rating-count hidden={count===0} class:list={['text-xs', tone === 'dark' ? 'text-crema-100/75' : 'text-ciruela-500']}>({count})</span>
    )
  }
</span>
