---
/**
 * Barra de confianza. Sin fila de 6 círculos iguales (plantilla): el respaldo de Hotmart va como
 * sello propio, con su marca y una rotación orgánica, y las demás garantías como una lista
 * tipográfica con iconos de trazo (`Icon.astro`) que fluye en lugar de encajar en una cuadrícula.
 */
import Icon from './Icon.astro';
import type { IconName } from '@/lib/icons';
import { SITE } from '@/lib/site';

const items: { icon: IconName; label: string; value: string }[] = [
  { icon: 'birrete', label: 'Certificado', value: 'digital verificable' },
  { icon: 'infinito', label: 'Acceso', value: 'de por vida' },
  { icon: 'chat', label: 'Soporte', value: 'por WhatsApp' },
  { icon: 'escudo', label: 'Garantía', value: '7 días' },
  { icon: 'maletin', label: `${SITE.stats.students} certificados`, value: `${SITE.stats.ventures} emprendimientos` },
];
---

<div class="border-y border-crema-200 bg-white">
  <div class="contenedor flex flex-col gap-5 py-6 lg:flex-row lg:items-center lg:gap-12">
    <!-- Plataforma de pago, con el logo oficial de Hotmart (decisión de JP, 11-11-2026: el logo
         se usa donde se informa del pago). No dice «partner oficial» ni sugiere respaldo. -->
    <p class="flex shrink-0 items-center gap-2.5 text-sm font-bold text-ciruela-800">
      <Icon name="candado" size={20} class="text-ciruela-600" />
      Pago seguro procesado por
      <img src="/brand/hotmart.svg" alt="Hotmart" width="75" height="24" class="h-6 w-auto" decoding="async" />
    </p>

    <ul class="scroll-reveal grid grid-cols-2 gap-x-4 gap-y-5 sm:flex sm:flex-wrap sm:gap-x-9 lg:flex-1 lg:justify-between lg:gap-x-6">
      {
        items.map((item, i) => (
          <li class:list={['flex items-center gap-2.5', i === items.length - 1 && 'col-span-2 sm:col-span-1']}>
            <Icon name={item.icon} size={22} class="text-coral-600" />
            <span class="leading-tight">
              <span class="block text-sm font-extrabold text-ciruela-800">{item.label}</span>
              <span class="block text-xs text-ciruela-500">{item.value}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
