---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RichBody from './RichBody.astro';
import {imageSource,type Document} from '@/lib/emdash-content';
interface Props {entry:Document;kind:'videos'|'graphics'}
const {entry,kind}=Astro.props;const d=entry.data;Astro.locals.cmsContent=entry;
const src=imageSource(kind==='videos'?d.video:d.image),poster=imageSource(d.poster);
---
<BaseLayout title={d.title} description={d.description??''} pageType={kind}>
 <article class="contenedor max-w-4xl py-14">
  <a href={kind==='videos'?'/videos/':'/recursos/'} class="font-bold text-coral-600">{kind==='videos'?'Videoteca':'Recursos visuales'}</a>
  <h1 class="mt-4 text-4xl font-semibold">{d.title}</h1><p class="mt-4 text-ciruela-600">{d.description}</p>
  {src&&(kind==='videos'?<video controls preload="metadata" poster={poster||undefined} class="mt-8 w-full rounded-2xl"><source src={src}/>Tu navegador no puede reproducir este video.</video>:<figure class="mt-8"><img src={src} alt={d.alt||d.title} class="h-auto w-full rounded-2xl"/><figcaption class="mt-3 text-sm">{d.credit}{d.license?` · ${d.license}`:''}</figcaption></figure>)}
  <div class="prose-blog mt-8"><RichBody value={entry.richBody}/></div>
  {d.transcript&&<section class="mt-8"><h2 class="text-2xl font-semibold">Transcripción</h2><p class="mt-4 whitespace-pre-line">{d.transcript}</p></section>}
  {d.course&&<a href={`/co/${d.course}/`} class="mt-8 inline-block font-bold text-coral-600">Ver curso relacionado →</a>}
 </article>
</BaseLayout>
