---
/**
 * Plataforma de pago, junto a los botones de compra: «Pago seguro procesado por» + logo de Hotmart.
 *
 * Decisión de JP (11-11-2026): el logo de Hotmart se usa donde se informa del pago y de la emisión
 * del certificado. Sustituye a la regla del 22-09-2026 de no usarlo en ningún sitio. Sigue sin
 * usarse para sugerir que Hotmart recomienda o respalda los cursos: solo dice quién cobra.
 * El SVG es el oficial, sin modificar (`public/brand/hotmart.svg`; versión en blanco para fondos
 * oscuros).
 */
import Icon from './Icon.astro';

interface Props {
  /** dark = para fondos oscuros. */
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 text-xs font-semibold whitespace-nowrap',
    tone === 'dark' ? 'text-crema-100/80' : 'text-ciruela-600',
    className,
  ]}
>
  <Icon name="candado" size={14} class={tone === 'dark' ? 'text-crema-100/80' : 'text-ciruela-500'} />
  <span>Pago seguro procesado por</span>
  <img
    src={tone === 'dark' ? '/brand/hotmart-blanco.svg' : '/brand/hotmart.svg'}
    alt="Hotmart"
    width="62"
    height="20"
    class="h-5 w-auto"
    decoding="async"
  />
</span>
