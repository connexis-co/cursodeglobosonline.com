---
import {responsiveImage} from '@/lib/image-transforms';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import RichBody from '@/themes/globos-classic/components/RichBody.astro';
import { getCollection, type CollectionEntry } from '@/lib/emdash-content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Wave from '@/components/Wave.astro';
import Balloons from '@/components/Balloons.astro';
import Rating from '@/components/Rating.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CourseCard from '@/components/CourseCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import CertificateShowcase from '@/components/CertificateShowcase.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import HotmartBadge from '@/components/HotmartBadge.astro';
import GuaranteeSeal from '@/components/GuaranteeSeal.astro';
import PromoDeadline from '@/components/PromoDeadline.astro';
import Icon from '@/components/Icon.astro';
import StickyCta from '@/components/StickyCta.astro';
import StarRating from '@/components/StarRating.astro';
import { formatPrice, type Country, type City } from '@/lib/countries';
import { getCategory } from '@/lib/emdash-content';
import { getCityLocal } from '@/lib/emdash-content';
import { buildHotmartUrl, buildHotmartProductUrl } from '@/lib/hotmart';
import { coursePricing, usd } from '@/lib/pricing';
import { postsForCourse, postUrl } from '@/lib/blog';
import { getCourseRating } from '@/lib/ratings';
import { countryAlternates, breadcrumbSchema, courseSchema, faqSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';

interface Props {
  country: Country;
  course: CollectionEntry<'courses'>;
  /** Página hiperlocal: curso a nivel ciudad (§6.2 del plan maestro). */
  city?: City;
}

const { country, course, city } = Astro.props;
Astro.locals.cmsContent=course as unknown as App.Locals["cmsContent"];
const d = course.data;

const category = await getCategory(d.category);
const cityLocal = city ? await getCityLocal(city.slug) : undefined;
const placeName = city ? city.name : country.name;

const { hasPrice, hasDiscount, discountPct } = coursePricing(d);
const priceDate = d.priceCheckedAt
  ? new Intl.DateTimeFormat('es', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(
      d.priceCheckedAt,
    )
  : undefined;

/** Un enlace por botón: `sck` lleva país, curso y ubicación al informe de ventas de Hotmart. */
const checkout = (placement: string) =>
  buildHotmartUrl({
    baseUrl: d.hotmartUrl,
    coupon: d.coupon,
    courseSlug: course.id,
    countryCode: country.code,
    citySlug: city?.slug,
    placement,
  });
// Ficha pública con reseñas, por el enlace de afiliado (la URL directa del marketplace no lleva `ref`).
const reviewsUrl = buildHotmartProductUrl(d.hotmartUrl, country.code, course.id);

const geoFaqs = [
  {
    q: `¿Puedo tomar el ${d.title} desde ${placeName}?`,
    a: `Sí. El curso es 100% online: pagas en Hotmart con métodos disponibles en ${country.name}, recibes el acceso al correo de inmediato y estudias desde el celular o el computador.`,
  },
  {
    q: `¿El certificado es válido en ${country.name}?`,
    a: `Sí. El certificado de estudios es digital, con validez internacional y verificación en línea, útil para tu portafolio y tus clientes en ${placeName}.`,
  },
  {
    q: `¿En qué moneda pago desde ${country.name}?`,
    a: `Hotmart muestra el precio en ${country.currency} (o USD, según el método) antes de confirmar el pago, con el descuento ya aplicado si el curso lo tiene.`,
  },
];
const allFaqs = [...d.faqs, ...geoFaqs, ...(cityLocal?.faqs ?? [])];

// Votos propios del sitio (D1): los mismos números en el widget y en el aggregateRating.
const siteRating = await getCourseRating(course.id);

// Anti-canibalización: la página curso-ciudad declara canonical → curso-país, así que
// el schema y el breadcrumb describen siempre la URL canónica.
const canonicalPath = `/${country.code}/${course.id}/`;
const courseUrl = `${SITE.url}${canonicalPath}`;
const schemas = [
  courseSchema({
    title: d.title,
    description: d.shortDescription,
    url: courseUrl,
    images: d.cover ? [new URL(d.cover, SITE.url).href] : [],
    level: d.level,
    category: category.name,
    learnings: d.learnings,
    price: d.priceUSD,
    priceEndsAt: d.promo?.endsAt,
    producer: d.producer,
    instructor: d.instructor,
    rating: siteRating,
  }),
  faqSchema(allFaqs),
  breadcrumbSchema([
    { name: country.name, url: `${SITE.url}/${country.code}/` },
    { name: 'Cursos', url: `${SITE.url}/${country.code}/cursos/` },
    { name: d.title, url: courseUrl },
  ]),
];

const related = (await getCollection('courses'))
  .filter((c) => c.id !== course.id)
  .sort((a, b) => (a.data.category === d.category ? -1 : 1) - (b.data.category === d.category ? -1 : 1))
  .slice(0, 3);

// Reseñas reales de Hotmart: primero las de este curso, luego las de otros cursos.
const allTestimonials = await getCollection('testimonials');
const testimonials = [
  ...allTestimonials.filter((t) => t.data.courseSlug === course.id),
  ...allTestimonials.filter((t) => t.data.courseSlug !== course.id),
].slice(0, 3);

const guides = await postsForCourse(course.id, 3);

// Title ≤ 60 car.: «curso de X online» al inicio (la búsqueda principal de la ficha) + país +
// un gancho verificable: el descuento real o, si no hay, el certificado.
// Con descuento se prueba primero con el precio; si no cabe, solo el porcentaje; y si tampoco, se
// quita «Online» antes que el descuento (está en el H1 y en la descripción).
const hasOffer = hasDiscount && Boolean(discountPct);
const titleOptions = hasOffer
  ? [
      `${d.title} Online en ${placeName}: ${discountPct}% OFF (${usd(d.priceUSD!)})`,
      `${d.title} Online en ${placeName}: ${discountPct}% OFF`,
      `${d.title} en ${placeName}: ${discountPct}% OFF`,
    ]
  : [`${d.title} Online en ${placeName} con Certificado`];
titleOptions.push(`${d.title} Online en ${placeName}`, `${d.title} en ${placeName}`);
const metaTitle = d.metaTitle ?? titleOptions.find((option) => option.length <= 60) ?? titleOptions.at(-1)!;
const description = (d.metaDescription ?? d.shortDescription).replaceAll('{lugar}', placeName);
const trackBase = {
  course_name: d.title,
  course_category: category.name,
  price: d.priceUSD ?? '',
  currency: d.priceUSD !== undefined ? 'USD' : '',
  country: country.code,
  city: city?.slug ?? '',
  discount_pct: discountPct ?? '',
};
const trackParams = JSON.stringify(trackBase);
/** begin_checkout con la posición del botón (auditoría P2-8: comparar clics por ubicación). */
const ctaTrack = (placement: 'hero' | 'aside_desktop' | 'certificate' | 'closing') =>
  JSON.stringify({ ...trackBase, placement });
// Texto alternativo descriptivo: el del archivo en el CMS si existe; si no, qué se aprende.
const coverAlt = d.coverAlt ?? `${d.title}: ${d.learnings[0] ?? d.shortDescription}`;
const ctaLabel = discountPct ? `Inscribirme con ${discountPct}% OFF` : 'Inscribirme ahora';

// Viñetas de "¿Este curso es para ti?": mini globo (anatomía de Balloons.astro) en colores
// y giros alternos, para que la lista no parezca de plantilla.
const BULLET_TONES = ['text-coral-500', 'text-aqua-500', 'text-sol-500', 'text-lila-500'];

---

<BaseLayout
  title={metaTitle}
  {description}
  {country}
  pathAfterCountry={`/${course.id}/`}
  alternates={city ? [] : await countryAlternates(`/${course.id}/`)}
  canonicalPath={city ? canonicalPath : undefined}
  {schemas}
  pageType={city ? 'course_city_page' : 'course_page'}
  whatsappContext={d.title}
>
  <!-- view_course (plan de medición §10) -->
  <script
    is:inline
    set:html={`window.dataLayer=window.dataLayer||[];window.dataLayer.push(Object.assign({event:'view_course',page_type:'course_page'},${trackParams}));`}
  />

  <!-- 1-2 · BREADCRUMBS + HERO -->
  <section id="curso-hero" class="relative overflow-hidden bg-crema-100 pt-6 lg:pt-8">
    <Balloons variant="corner-left" />
    <div class="contenedor relative pb-12 lg:pb-16">
      <nav class="mb-4 text-xs text-ciruela-500 lg:mb-8" aria-label="Miga de pan">
        <a href={`/${country.code}/`} class="inline-block py-1 hover:text-coral-600 lg:py-0">{country.flag} {country.name}</a>
        {
          city && (
            <>
              <span aria-hidden="true"> / </span>
              <a href={`/${country.code}/${city.slug}/`} class="inline-block py-1 hover:text-coral-600 lg:py-0">
                {city.name}
              </a>
            </>
          )
        }
        <span aria-hidden="true"> / </span>
        <a href={`/${country.code}/cursos/`} class="inline-block py-1 hover:text-coral-600 lg:py-0">Cursos</a>
        <span aria-hidden="true"> / </span>
        <span class="font-bold text-ciruela-600">{d.title}</span>
      </nav>

      <!-- Mobile: título → imagen → cuadro de compra (patrón de plataforma).
           Desktop: texto+precio a la izquierda, imagen a la derecha. -->
      <div class="grid items-start gap-x-10 gap-y-6 lg:grid-cols-[1.15fr_1fr]">
        <div class="lg:col-start-1">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-xs font-extrabold text-ciruela-700 shadow-tarjeta">
            <Icon name={category.icon} class="text-coral-600" />
            {category.name} · {d.level}
          </span>
          <h1 class="mt-4 text-3xl font-semibold text-balance text-ciruela-900 sm:text-4xl lg:text-[2.75rem]">
            {d.title} online en {placeName}
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-ciruela-500">{d.shortDescription}</p>

          <StarRating contentId={course.id} contentTitle={d.title} rating={siteRating} class="mt-4" />

          <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-2 text-sm font-semibold text-ciruela-600">
            {
              d.hotmartRating && (
                <a
                  href={reviewsUrl}
                  target="_blank"
                  rel="noopener nofollow sponsored"
                  class="inline-flex items-center gap-1.5 hover:text-coral-600"
                  title="Valoración pública del curso en Hotmart"
                >
                  <Rating rating={d.hotmartRating.value} />
                  <span class="text-xs font-semibold text-ciruela-500">
                    {d.hotmartRating.count} {d.hotmartRating.count === 1 ? 'valoración' : 'valoraciones'} en Hotmart
                  </span>
                </a>
              )
            }
            {d.hotmartRating && <span class="text-coral-400" aria-hidden="true">·</span>}
            <span>{d.lessonsCount} videos</span>
            <span class="text-coral-400" aria-hidden="true">·</span>
            <span>Certificado de estudios</span>
            <span class="text-coral-400" aria-hidden="true">·</span>
            <span>Acceso de por vida</span>
          </div>
        </div>

        <!-- Móvil: 16/10 y sin giro para que la caja de compra suba en el primer viewport (P1-1). -->
        <div class="relative mx-auto w-full max-w-md lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center">
          <div class="overflow-hidden rounded-2xl shadow-globo">
            {
              d.video ? (<video controls preload="metadata" poster={d.cover ? responsiveImage(d.cover,{siteUrl:SITE.url,sizes:'448px',maxWidth:960}).src : undefined} class="aspect-video w-full"><source src={d.video}/></video>) : d.cover ? (
                <ResponsiveImage sizes="(min-width: 448px) 448px, calc(100vw - 48px)" maxWidth={960}
                  src={d.cover}
                  alt={coverAlt}
                  class="aspect-[16/10] w-full object-cover sm:aspect-[4/3]"
                  width="600"
                  height="450"
                  fetchpriority="high"
                />
              ) : null
            }
          </div>
          <!-- Globo fotográfico que asoma tras la portada (mismo material que Balloons.astro). -->
          <img
            class="animate-balloon-float absolute -top-10 -left-7 hidden w-[4.5rem] sm:block"
            style="animation-duration: 5.5s"
            src="/images/globos/aqua-160.webp"
            srcset="/images/globos/aqua-160.webp 160w, /images/globos/aqua-320.webp 320w"
            sizes="72px"
            width="72"
            height="95"
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="lg:col-start-1">
          <div data-buy-box class="rounded-3xl border border-crema-200 bg-white p-5 shadow-tarjeta sm:p-6">
            {
              hasPrice ? (
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                  <div>
                    {hasDiscount && (
                      <span class="block text-xs text-ciruela-500">
                        Antes <s>{usd(d.originalPriceUSD!)}</s>
                      </span>
                    )}
                    <span class="block font-display text-3xl font-bold text-coral-600">{usd(d.priceUSD!)}</span>
                    <span class="block text-xs text-ciruela-500">
                      ≈ {formatPrice(d.priceUSD!, country)} · Hotmart confirma el valor exacto en {country.currency}
                    </span>
                  </div>
                  {hasDiscount && discountPct && (
                    <span class="rounded-full bg-coral-600 px-4 py-2 text-sm font-extrabold text-white">
                      {d.promo ? `${d.promo.label}: ${discountPct}% OFF` : `${discountPct}% OFF aplicado en el enlace`}
                    </span>
                  )}
                  <PromoDeadline promo={d.promo} class="basis-full" />
                  {priceDate && (
                    <span class="basis-full text-[0.7rem] text-ciruela-400">
                      Precio verificado en el checkout de Hotmart el {priceDate}. Pago único, sin mensualidades.
                    </span>
                  )}
                </div>
              ) : (
                <p class="flex items-start gap-2.5 text-sm font-bold text-ciruela-600">
                  <Icon name="tarjeta" size={20} class="text-coral-600" />
                  <span>
                    El precio se muestra en {country.currency} en el checkout seguro de Hotmart, antes de confirmar
                    el pago.
                  </span>
                </p>
              )
            }
            <div class="mt-5 flex flex-col gap-3 sm:flex-row">
              <a
                href={checkout('hero')}
                target="_blank"
                rel="noopener"
                data-track="begin_checkout"
                data-track-params={ctaTrack('hero')}
                class="rounded-xl bg-coral-600 px-8 py-4 text-center text-sm font-bold text-white shadow-boton transition-all duration-300 ease-fiesta hover:-translate-y-0.5 hover:bg-coral-700"
              >
                {ctaLabel}
              </a>
              <a
                href="#temario"
                class="rounded-xl border-2 border-crema-300 px-8 py-4 text-center text-sm font-bold text-ciruela-600 transition-colors hover:border-coral-300 hover:text-coral-600"
              >
                Ver temario
              </a>
            </div>
            <div class="mt-3.5 flex flex-wrap items-center gap-x-4 gap-y-1.5">
              <HotmartBadge />
              <p class="inline-flex items-center gap-1.5 text-sm font-semibold text-ciruela-600">
                <Icon name="escudo" class="text-aqua-700" />
                7 días de garantía con devolución del 100%.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <Wave color="var(--color-crema-50)" />
  </section>

  <!-- 3 · BARRA DE DATOS -->
  <section class="contenedor py-8">
    <dl class="grid grid-cols-2 gap-x-6 gap-y-5 border-y border-crema-200 py-6 text-sm sm:grid-cols-3 lg:grid-cols-6">
      {
        [
          ['Contenido', `${d.lessonsCount} videos`],
          ['Nivel', d.level],
          ['Modalidad', '100% online'],
          ['Acceso', 'De por vida'],
          ['Certificado', 'Incluido'],
          ['Garantía', '7 días'],
        ].map(([term, value]) => (
          <div>
            <dt class="text-xs text-ciruela-500">{term}</dt>
            <dd class="mt-0.5 font-bold text-ciruela-900">{value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- 4-6 · DESCRIPCIÓN + RESULTADOS + TEMARIO en un solo carril (P1-2). En desktop el aside
       ocupa las 3 filas, así la compra compacta sigue al lector hasta el final del temario. En
       móvil el orden no cambia: prosa → aside → resultados (banda a sangre) → temario. -->
  <div class="contenedor grid gap-12 pt-10 pb-14 lg:grid-cols-[1.5fr_1fr] lg:gap-y-14">
    <!-- 4 · DESCRIPCIÓN (cuerpo MDX) -->
    <article class="prosa scroll-reveal lg:col-start-1 lg:row-start-1">
      <h2 class="text-2xl font-semibold text-ciruela-900 sm:text-3xl">Qué vas a aprender en el {d.title}</h2>
      <RichBody value={course.richBody} />
    </article>

    <aside class="space-y-6 lg:col-start-2 lg:row-span-3 lg:row-start-1">
      <!-- 9 · PARA QUIÉN ES -->
      <div class="scroll-reveal rounded-3xl border border-crema-200 bg-white p-6 shadow-tarjeta">
        <h2 class="font-display text-xl font-semibold text-ciruela-900">¿Este curso es para ti?</h2>
        <ul class="mt-4 space-y-3 text-sm text-ciruela-600">
          {
            d.audience.map((item, i) => (
              <li class="flex items-start gap-2.5">
                <svg
                  class:list={['mt-0.5 h-[1.15rem] w-3 shrink-0', BULLET_TONES[i % BULLET_TONES.length]]}
                  viewBox="0 0 40 62"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M20 1.5C30.5 1.5 38.5 10 38.5 21c0 9.5-7 18.5-15 21.7l-3.5.9-3.5-.9C8.5 39.5 1.5 30.5 1.5 21 1.5 10 9.5 1.5 20 1.5Z"
                    fill="currentColor"
                  />
                  <ellipse cx="13.5" cy="13" rx="6" ry="9.5" fill="white" opacity="0.38" transform="rotate(-20 13.5 13)" />
                  <path d="M20 43c-2.6 1.6-3.6 3.2-3 4.8h6c.6-1.6-.4-3.2-3-4.8Z" fill="currentColor" />
                  <path d="M20 48.5q-4 7 .5 12" stroke="currentColor" stroke-opacity="0.55" stroke-width="2.6" stroke-linecap="round" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <!-- 10 · REQUISITOS -->
      <div class="scroll-reveal rounded-3xl border border-crema-200 bg-crema-100 p-6">
        <h2 class="font-display text-xl font-semibold text-ciruela-900">Requisitos</h2>
        <ul class="mt-4 space-y-2.5 text-sm text-ciruela-600">
          <li class="flex items-start gap-2">
            <Icon name="check" class="mt-0.5 text-aqua-700" />Cero experiencia previa: se empieza desde el kit básico
          </li>
          <li class="flex items-start gap-2">
            <Icon name="check" class="mt-0.5 text-aqua-700" />Conexión a internet (celular o computador)
          </li>
          <li class="flex items-start gap-2">
            <Icon name="check" class="mt-0.5 text-aqua-700" />Globos de buena calidad y ganas de practicar
          </li>
        </ul>
      </div>

      <!-- 8b · COMPRA COMPACTA (solo desktop · P1-2): va al final del aside para que, al fijarse,
           no se deslicen tarjetas por debajo; queda fija durante resultados y temario. En móvil la
           cubre StickyCta; sin data-buy-box para que StickyCta siga observando la caja del hero. -->
      <div class="hidden rounded-3xl border border-crema-200 bg-white p-6 shadow-globo lg:sticky lg:top-24 lg:block">
        <p class="font-display text-lg leading-snug font-semibold text-ciruela-900">{d.title}</p>
        {
          hasPrice ? (
            <div class="mt-3">
              <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                <span class="font-display text-3xl font-bold text-coral-600">{usd(d.priceUSD!)}</span>
                {hasDiscount && <s class="text-sm text-ciruela-500">{usd(d.originalPriceUSD!)}</s>}
                {hasDiscount && discountPct && (
                  <span class="rounded-full bg-coral-600 px-2.5 py-0.5 text-xs font-extrabold text-white">
                    −{discountPct}%
                  </span>
                )}
              </div>
              <p class="mt-1 text-xs text-ciruela-500">
                ≈ {formatPrice(d.priceUSD!, country)} · Hotmart confirma el valor exacto
              </p>
              <PromoDeadline promo={d.promo} class="mt-2" />
            </div>
          ) : (
            <p class="mt-3 flex items-start gap-2 text-sm font-bold text-ciruela-600">
              <Icon name="tarjeta" size={18} class="mt-px text-coral-600" />
              <span>Precio en {country.currency}, visible en el checkout de Hotmart antes de pagar.</span>
            </p>
          )
        }
        <a
          href={checkout('aside')}
          target="_blank"
          rel="noopener"
          data-track="begin_checkout"
          data-track-params={ctaTrack('aside_desktop')}
          class="mt-5 block rounded-xl bg-coral-600 px-6 py-3.5 text-center text-sm font-bold text-white shadow-boton transition-all duration-300 ease-fiesta hover:-translate-y-0.5 hover:bg-coral-700"
        >
          {ctaLabel}
        </a>
        <ul class="mt-4 space-y-2 text-xs font-semibold text-ciruela-600">
          <li class="flex items-center gap-2">
            <Icon name="escudo" class="text-aqua-700" />7 días de garantía con devolución del 100%
          </li>
          <li class="flex items-center gap-2">
            <Icon name="play" class="text-coral-600" />{d.lessonsCount} videos · acceso de por vida
          </li>
          <li class="flex items-center gap-2">
            <Icon name="birrete" class="text-coral-600" />Certificado de estudios
          </li>
        </ul>
        <HotmartBadge class="mt-4" />
      </div>
    </aside>

    <!-- 5 · QUÉ APRENDERÁS -->
    <section
      class="-mx-5 bg-crema-100 px-5 py-14 sm:-mx-8 sm:px-8 lg:col-start-1 lg:row-start-2 lg:mx-0 lg:rounded-3xl lg:px-10 lg:py-10"
    >
      <SectionHeading eyebrow="Resultados" title={`Lo que sabrás hacer al terminar el ${d.title}`} />
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          d.learnings.map((item, i) => (
            <div class="scroll-reveal flex items-start gap-3 rounded-2xl bg-white p-4 shadow-tarjeta" style={`animation-delay:${i * 50}ms`}>
              <svg class="mt-0.5 shrink-0 text-coral-500" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="10" fill="currentColor" opacity="0.15" />
                <path d="m8 12.5 2.7 2.7L16.5 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="text-sm font-semibold text-ciruela-700">{item}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 6 · TEMARIO -->
    <section id="temario" class="scroll-mt-24 lg:col-start-1 lg:row-start-3">
      <SectionHeading
        eyebrow="Temario"
        title={`Temario del ${d.title}: ${d.modules.length} módulos`}
        lead="Los primeros módulos aparecen abiertos para que veas exactamente qué contiene el curso."
      />
      <div class="mt-8 space-y-4">
        {
          d.modules.map((mod, i) => (
            <details
              class="temario-item group rounded-3xl border border-crema-200 bg-white shadow-tarjeta"
              open={i < 2}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 [&::-webkit-details-marker]:hidden">
                <span class="flex items-center gap-4">
                  <span class="font-display flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-coral-50 text-lg font-bold text-coral-600">
                    {i + 1}
                  </span>
                  <span class="font-bold text-ciruela-800">{mod.title}</span>
                </span>
                <span class="flex items-center gap-3 text-xs text-ciruela-400">
                  <span class="hidden sm:inline">{mod.lessons.length} lecciones</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" class="transition-transform duration-300 group-open:rotate-180" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </summary>
              <ul class="space-y-2.5 px-6 pb-6 sm:pl-20">
                {mod.lessons.map((lesson) => (
                  <li class="flex items-center gap-2.5 text-sm text-ciruela-600">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="shrink-0 text-coral-400" aria-hidden="true">
                      <path d="M8 5v14l11-7L8 5Z" />
                    </svg>
                    {lesson}
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
      </div>
    </section>
  </div>

  <!-- 7 · INSTRUCTOR -->
  {
    d.instructor && (
      <section class="bg-ciruela-900 py-14 text-crema-50">
        <div class="contenedor grid items-center gap-8 lg:grid-cols-[auto_1fr]">
          {d.instructor.photo ? (
            <ResponsiveImage sizes="160px" maxWidth={320}
              src={d.instructor.photo}
              alt={`Foto de ${d.instructor.name}, instructor del curso`}
              class="mx-auto h-40 w-40 rounded-2xl object-cover"
              loading="lazy"
              decoding="async"
              width="160"
              height="160"
            />
          ) : (
            <span class="font-display mx-auto flex h-40 w-40 items-center justify-center rounded-3xl bg-coral-500 text-6xl font-bold">
              {d.instructor.name.charAt(0)}
            </span>
          )}
          <div class="text-center lg:text-left">
            <p class="text-sm font-bold text-sol-300">Tu instructor</p>
            <h2 class="mt-2 text-2xl font-semibold sm:text-3xl">
              <span class="sr-only">Instructor del {d.title}: </span>{d.instructor.name}
            </h2>
            <p class="mt-1 text-sm font-bold text-crema-100/70">{d.instructor.title}</p>
            <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-crema-100/80 lg:mx-0">
              {d.instructor.bio}
            </p>
          </div>
        </div>
      </section>
    )
  }

  <!-- 8 · CERTIFICADO -->
  <section class="contenedor grid items-center gap-12 py-16 lg:grid-cols-2">
    <div class="scroll-reveal order-2 lg:order-1">
      <SectionHeading
        eyebrow="Certificado"
        title={`Certificado del ${d.title}`}
        lead="Completa el 100% de las lecciones y descarga tu certificado de estudios con validez internacional."
      />
      <ul class="mt-6 space-y-3 text-sm text-ciruela-600">
        <li class="flex items-start gap-2">
          <Icon name="check" class="mt-0.5 text-coral-600" />Digital, verificable y listo para compartir
        </li>
        <li class="flex items-start gap-2">
          <Icon name="check" class="mt-0.5 text-coral-600" />Con tareas calificadas durante el curso
        </li>
        <li class="flex items-start gap-2">
          <Icon name="check" class="mt-0.5 text-coral-600" />Emitido a través de Hotmart
        </li>
      </ul>
      <div class="mt-6" data-track="view_certificate" data-track-params={JSON.stringify({ course_name: d.title })}>
        <a
          href={checkout('certificado')}
          target="_blank"
          rel="noopener"
          data-track="begin_checkout"
          data-track-params={ctaTrack('certificate')}
          class="inline-block rounded-xl bg-coral-600 px-7 py-3.5 text-sm font-bold text-white shadow-boton transition-all duration-300 ease-fiesta hover:-translate-y-0.5 hover:bg-coral-700"
        >
          Quiero mi certificado
        </a>
      </div>
    </div>
    <div class="order-1 lg:order-2">
      <CertificateShowcase courseName={d.title} />
    </div>
  </section>

  <!-- 11 · TESTIMONIOS -->
  <section class="bg-crema-100 py-14">
    <div class="contenedor">
      <SectionHeading
        eyebrow="Reseñas reales"
        title="Lo que escriben las alumnas en Hotmart"
        lead="Citas textuales de la ficha pública de cada curso en Hotmart, la plataforma donde se compra y se estudia."
      />
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          testimonials.map((t, i) => (
            <div class="scroll-reveal" style={`animation-delay:${i * 60}ms`}>
              <TestimonialCard testimonial={t} />
            </div>
          ))
        }
      </div>
      <div
        id="calificar"
        class="mx-auto mt-10 max-w-2xl scroll-mt-28 rounded-3xl border border-crema-200 bg-white px-6 py-8 text-center shadow-tarjeta sm:px-10"
      >
        <h3 class="font-display text-xl font-semibold text-ciruela-900 sm:text-2xl">¿Tomaste el {d.title}? Califícalo</h3>
        <p class="mx-auto mt-2 max-w-md text-sm text-ciruela-500">
          Tu voto de 1 a 5 estrellas ayuda a otras personas a elegir. Es anónimo y puedes cambiarlo cuando quieras.
        </p>
        <StarRating
          contentId={course.id}
          contentTitle={d.title}
          rating={siteRating}
          size="lg"
          center
          prompt="Elige de 1 a 5 estrellas"
          class="mt-5"
        />
      </div>
    </div>
  </section>

  <!-- 12 · GARANTÍA + PRICING FINAL -->
  <section class="contenedor py-16">
    <div class="rounded-2xl bg-ciruela-900 p-8 text-crema-50 sm:p-12">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,27rem)] lg:gap-14">
        <div class="text-center lg:text-left">
          <h2 class="mx-auto max-w-xl text-3xl font-semibold text-balance lg:mx-0">
            {
              d.promo
                ? `${d.promo.label}: inscríbete con el ${discountPct}% de descuento`
                : discountPct
                  ? `Inscríbete hoy con el ${discountPct}% de descuento`
                  : 'Inscríbete hoy y empieza en minutos'
            }
          </h2>
          {
            hasPrice && (
              <p class="mt-5">
                {hasDiscount && (
                  <span class="text-sm text-crema-100/70">
                    Antes <s>{usd(d.originalPriceUSD!)}</s>
                  </span>
                )}
                <span class="font-display mx-3 text-4xl font-bold text-sol-300 lg:first:ml-0">{usd(d.priceUSD!)}</span>
                <span class="block text-xs text-crema-100/70">≈ {formatPrice(d.priceUSD!, country)}</span>
              </p>
            )
          }
          <PromoDeadline promo={d.promo} tone="oscuro" class="mt-3" />
          <p class="mx-auto mt-4 max-w-md text-sm text-crema-100/75 lg:mx-0">
            Pago único. El acceso llega a tu correo en cuanto se confirma el pago.
          </p>
          <a
            href={checkout('cierre')}
            target="_blank"
            rel="noopener"
            data-track="begin_checkout"
            data-track-params={ctaTrack('closing')}
            class="mt-7 inline-block rounded-xl bg-coral-600 px-10 py-4 text-sm font-bold text-white shadow-boton transition-all duration-300 ease-fiesta hover:-translate-y-1 hover:bg-coral-700"
          >
            {ctaLabel}
          </a>
          <p class="mt-5"><HotmartBadge tone="dark" /></p>
        </div>

        <!-- Garantía: sello estampado (lámina dorada en SVG) y, al lado, qué cubre y quién devuelve
             el dinero. -->
        <div class="mx-auto flex w-full max-w-sm flex-col items-center gap-5 border-t border-crema-50/25 pt-8 text-center sm:flex-row sm:text-left lg:mx-0 lg:max-w-none lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
          <GuaranteeSeal class="h-auto w-36 shrink-0 sm:w-40" />
          <div>
            <p class="font-display text-xl font-bold">Garantía de 7 días</p>
            <p class="mt-2 text-sm leading-relaxed text-crema-100/80">
              Entra, mira las lecciones y decide. Si el curso no es para ti, pides el reembolso y recuperas el 100 % de tu dinero.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 15 · CONTEXTO LOCAL (solo páginas de ciudad, §6.2) -->
  {
    city && cityLocal && (
      <section class="contenedor pb-16">
        <div class="relative overflow-hidden rounded-[2rem] border border-crema-200 bg-crema-100 p-8 sm:p-10">
          <SectionHeading
            eyebrow={`${country.flag} ${city.name}`}
            title={`Aprender decoración con globos en ${city.name}`}
          />
          <p class="mt-5 max-w-3xl leading-relaxed text-ciruela-600">{cityLocal.hook}</p>
          <p class="mt-6 text-sm font-bold text-ciruela-600">Cursos de globos en otras ciudades</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {country.cities
              .filter((c) => c.slug !== city.slug)
              .map((c) => (
                <a
                  href={`/${country.code}/${c.slug}/`}
                  class="rounded-full border border-crema-300 bg-white px-3.5 py-2.5 text-xs font-bold text-ciruela-600 transition-colors hover:border-coral-300 hover:text-coral-600"
                >
                  {c.name}
                </a>
              ))}
            <a
              href={`/${country.code}/${course.id}/`}
              class="inline-flex items-center gap-1 rounded-full bg-coral-600 px-3.5 py-2.5 text-xs font-extrabold text-white transition-colors hover:bg-coral-700"
            >
              {d.title} en {country.name} <Icon name="flecha" size={14} />
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- 13b · GUÍAS GRATIS DEL BLOG (enlazado interno blog ↔ money page) -->
  {
    guides.length > 0 && (
      <section class="contenedor pb-16" aria-labelledby="guias-titulo">
        <div class="rounded-[2rem] border border-crema-200 bg-white p-8 shadow-tarjeta sm:p-10">
          <h2 id="guias-titulo" class="text-2xl font-semibold text-ciruela-900 sm:text-3xl">
            Guías gratis para practicar antes de inscribirte
          </h2>
          <!-- Columnas según el número de guías: con 1 o 2 no quedan huecos vacíos en desktop. -->
          <ul
            class:list={[
              'mt-6 grid gap-4',
              guides.length === 2 && 'sm:grid-cols-2',
              guides.length >= 3 && 'sm:grid-cols-3',
            ]}
          >
            {guides.map((g) => (
              <li>
                <a
                  href={postUrl(g)}
                  class:list={[
                    'group block h-full rounded-2xl border border-crema-200 bg-crema-50 p-5 transition-colors hover:border-coral-300',
                    guides.length === 1 && 'sm:flex sm:items-center sm:gap-6',
                  ]}
                >
                  <span class={guides.length === 1 ? 'block sm:flex-1' : 'block'}>
                    <span class="block font-display text-lg leading-snug font-semibold text-ciruela-900 group-hover:text-coral-700">
                      {g.data.title}
                    </span>
                    <span class="mt-2 line-clamp-2 block text-sm text-ciruela-500">{g.data.description}</span>
                  </span>
                  {guides.length === 1 && (
                    <Icon
                      name="flecha"
                      size={20}
                      class="hidden text-coral-600 transition-transform duration-300 group-hover:translate-x-1 sm:block"
                    />
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 13 · FAQ -->
  <section class="contenedor max-w-4xl pb-16">
    <SectionHeading eyebrow="Preguntas frecuentes" title={`Dudas sobre el ${d.title}`} align="center" />
    <div class="mt-8">
      <FaqAccordion faqs={allFaqs} courseName={d.title} />
    </div>
  </section>

  <!-- 14 · RELACIONADOS -->
  <section class="contenedor pb-20">
    <SectionHeading eyebrow="Sigue aprendiendo" title="También te puede interesar" />
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((c) => <CourseCard course={c} {country} />)}
    </div>
  </section>

  <StickyCta
    {country}
    priceUSD={d.priceUSD}
    originalPriceUSD={hasDiscount ? d.originalPriceUSD : undefined}
    discountPct={discountPct}
    hotmartUrl={checkout('barra-movil')}
    courseName={d.title}
    coupon={d.coupon ?? (discountPct ? `offDiscount-${discountPct}` : '')}
  />
</BaseLayout>

<style>
  /* Prosa del cuerpo MDX con la voz tipográfica del sitio */
  .prosa :global(p) {
    margin-block: 1rem;
    line-height: 1.75;
    color: var(--color-ciruela-600);
  }
  .prosa :global(h3) {
    margin-top: 2.2rem;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-ciruela-900);
  }
</style>
