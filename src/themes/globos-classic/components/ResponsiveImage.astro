---
import type { HTMLAttributes } from 'astro/types';
import {responsiveImage} from '@/lib/image-transforms';
import {SITE} from '@/lib/site';

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'sizes'> & {
  src: string;
  sizes: string;
  maxWidth?: number;
};
// A high-priority image is the LCP candidate: lazy loading would hold it until layout (8 s on slow mobile).
const {src, sizes, maxWidth, fetchpriority, loading = fetchpriority === 'high' ? 'eager' : 'lazy', decoding = 'async', ...attributes} = Astro.props;
const image = responsiveImage(src, {siteUrl: SITE.url, sizes, maxWidth});
---
<img {...attributes} {...image} {fetchpriority} {loading} {decoding} />
