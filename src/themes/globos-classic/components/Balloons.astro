---
/**
 * Globos que suben dentro de una sección (variante `rise`): fotos de globos de látex con su
 * cuerda, animadas solo con CSS.
 *
 * Los globos grandes del hero y de las esquinas (`hero`, `corner-left`, `corner-right`) ya no se
 * pintan aquí: quedaban recortados por el borde de su sección y no acompañaban el scroll. Los
 * sustituye la bandada de página con física (`BalloonFlock.astro`, montada en BaseLayout). Las
 * variantes se siguen aceptando para no tocar cada página que las pide.
 */
interface Props {
  variant?: 'hero' | 'rise' | 'corner-left' | 'corner-right';
}
const { variant = 'hero' } = Astro.props;

type Tone = 'frambuesa' | 'aqua' | 'sol' | 'lila' | 'dorado';
const RATIO: Record<Tone, number> = { frambuesa: 1.306, aqua: 1.325, sol: 1.343, lila: 1.266, dorado: 1.35 };
const RISE: { tone: Tone; size: number; left: string; delay: string; duration: string; blur?: number }[] = [
  { tone: 'frambuesa', size: 44, left: '8%', delay: '0s', duration: '16s' },
  { tone: 'aqua', size: 34, left: '28%', delay: '4s', duration: '19s', blur: 0.8 },
  { tone: 'sol', size: 40, left: '52%', delay: '8s', duration: '17s' },
  { tone: 'lila', size: 30, left: '72%', delay: '2s', duration: '20s', blur: 1 },
  { tone: 'dorado', size: 36, left: '88%', delay: '6s', duration: '18s' },
];
---

{
  variant === 'rise' && (
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      {RISE.map((b) => (
        <div class="sube" style={`left:${b.left};width:${b.size}px;`}>
          <div class="animate-balloon-rise" style={`animation-delay:${b.delay};animation-duration:${b.duration};`}>
            <img
              style={b.blur ? `filter:blur(${b.blur}px);` : undefined}
              src={`/images/globos/${b.tone}-160.webp`}
              width={b.size}
              height={Math.round(b.size * RATIO[b.tone])}
              alt=""
              loading="lazy"
              decoding="async"
              draggable="false"
            />
            <svg viewBox="0 0 20 60" width={Math.round(b.size * 0.45)} height={Math.round(b.size * 1.35)} focusable="false">
              <path d="M10 0 C4 14 15 24 9 38 C6 46 12 52 10 60" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  )
}

<style>
  .sube {
    position: absolute;
    top: 100%;
  }
  .sube img {
    display: block;
    width: 100%;
    height: auto;
  }
  .sube svg {
    display: block;
    margin: -2px auto 0;
    overflow: visible;
  }
  .sube path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 0.7;
    opacity: 0.5;
  }
  @media (prefers-reduced-motion: reduce) {
    .sube {
      display: none;
    }
  }
</style>
