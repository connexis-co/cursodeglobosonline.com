---
/**
 * Icono SVG de trazo propio (ver `src/lib/icons.ts`). Hereda el color con `currentColor`:
 * se colorea con clases de texto (`text-coral-600`, `text-sol-300`…), nunca con emojis.
 * Siempre decorativo (`aria-hidden`): el texto que lo acompaña es el que se lee.
 *
 *   <Icon name="birrete" />                       → 16 px
 *   <Icon name="escudo" size={20} class="text-aqua-700" />
 *   <Icon name="estrella" class="fill-current" />  → relleno
 */
import type { HTMLAttributes } from 'astro/types';
import { ICONS, type IconName } from '@/lib/icons';

type Props = Omit<HTMLAttributes<'svg'>, 'name' | 'width' | 'height'> & {
  name: IconName;
  /** Lado en px (el lienzo es 24×24). */
  size?: number;
  /** Grosor del trazo en unidades del lienzo; 1.8 por defecto (sistema). */
  strokeWidth?: number;
};

const { name, size = 16, strokeWidth = 1.8, class: className, ...rest } = Astro.props;
const paths = ICONS[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={['shrink-0', className]}
  {...rest}
>
  {paths.map((d) => <path d={d} />)}
</svg>
