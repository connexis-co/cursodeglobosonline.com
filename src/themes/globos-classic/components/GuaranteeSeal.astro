---
/**
 * Sello de garantía de 7 días en SVG: lámina dorada con borde dentado fino, leyenda en círculo y
 * cifra en relieve. Pedido por JP (11-11-2026) en lugar del rosetón de caricatura anterior: tiene
 * que parecer un sello estampado de verdad, no un dibujo.
 *
 * Todo sale de geometría (dientes y radios calculados), degradados y un filtro de sombra; el texto
 * es texto real del SVG, con la tipografía de titulares de la página.
 */
interface Props {
  class?: string;
  /** Sufijo para los id internos cuando hay más de un sello en la página. */
  id?: string;
}
const { class: className, id = 'sello' } = Astro.props;

// Borde dentado: 64 dientes finos alrededor del círculo.
const TEETH = 64;
const edge = Array.from({ length: TEETH * 2 }, (_, i) => {
  const radius = i % 2 === 0 ? 97 : 91.5;
  const angle = (i / (TEETH * 2)) * Math.PI * 2 - Math.PI / 2;
  return `${(100 + radius * Math.cos(angle)).toFixed(2)},${(100 + radius * Math.sin(angle)).toFixed(2)}`;
}).join(' ');
// Anillo de puntos entre la leyenda y el centro.
const DOTS = 72;
const dots = Array.from({ length: DOTS }, (_, i) => {
  const angle = (i / DOTS) * Math.PI * 2;
  return [100 + 51.5 * Math.cos(angle), 100 + 51.5 * Math.sin(angle)].map((n) => n.toFixed(2));
});
---

<svg class={className} viewBox="0 0 200 200" role="img" aria-label="Sello: garantía de 7 días con reembolso del 100 %">
  <defs>
    <linearGradient id={`${id}-oro`} x1="0.15" y1="0.05" x2="0.85" y2="0.95">
      <stop offset="0" stop-color="#fbeaa8"></stop>
      <stop offset="0.28" stop-color="#e3b958"></stop>
      <stop offset="0.52" stop-color="#f6dd92"></stop>
      <stop offset="0.76" stop-color="#c8963a"></stop>
      <stop offset="1" stop-color="#f0d07a"></stop>
    </linearGradient>
    <linearGradient id={`${id}-oro-hondo`} x1="0.85" y1="0.95" x2="0.15" y2="0.05">
      <stop offset="0" stop-color="#f7e3a0"></stop>
      <stop offset="0.45" stop-color="#cfa044"></stop>
      <stop offset="1" stop-color="#eccb74"></stop>
    </linearGradient>
    <radialGradient id={`${id}-centro`} cx="0.38" cy="0.3" r="0.8">
      <stop offset="0" stop-color="#fdf2c4"></stop>
      <stop offset="0.6" stop-color="#ecc96d"></stop>
      <stop offset="1" stop-color="#c8983c"></stop>
    </radialGradient>
    <linearGradient id={`${id}-brillo`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0.3" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset="0.45" stop-color="#fff" stop-opacity="0.42"></stop>
      <stop offset="0.56" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
    <filter id={`${id}-sombra`} x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="3" stdDeviation="3.2" flood-color="#1b1430" flood-opacity="0.38"></feDropShadow>
    </filter>
    <clipPath id={`${id}-recorte`}><circle cx="100" cy="100" r="91"></circle></clipPath>
    <!-- Recorridos de la leyenda: arco superior e inferior (este, al revés para que se lea). -->
    <path id={`${id}-arriba`} d="M 34 100 A 66 66 0 0 1 166 100"></path>
    <path id={`${id}-abajo`} d="M 27 100 A 73 73 0 0 0 173 100"></path>
  </defs>

  <g filter={`url(#${id}-sombra)`}>
    <polygon points={edge} fill={`url(#${id}-oro)`} stroke="#9a6f1f" stroke-width="0.6" stroke-linejoin="round"></polygon>
  </g>
  <circle cx="100" cy="100" r="88" fill={`url(#${id}-oro-hondo)`} stroke="#8f661b" stroke-width="0.7"></circle>
  <circle cx="100" cy="100" r="84.5" fill="none" stroke="#fff4c6" stroke-width="0.6" opacity="0.9"></circle>
  <circle cx="100" cy="100" r="56.5" fill="none" stroke="#8f661b" stroke-width="0.7"></circle>
  {dots.map(([cx, cy]) => <circle cx={cx} cy={cy} r="0.75" fill="#8f661b"></circle>)}
  <circle cx="100" cy="100" r="46.5" fill={`url(#${id}-centro)`} stroke="#8f661b" stroke-width="0.8"></circle>
  <circle cx="100" cy="100" r="43.5" fill="none" stroke="#fff6cf" stroke-width="0.5" opacity="0.85"></circle>

  <!-- Leyenda en círculo -->
  <g fill="#4a3208" font-family="var(--font-display)" font-weight="700" font-size="11" letter-spacing="2.2">
    <text><textPath href={`#${id}-arriba`} startOffset="50%" text-anchor="middle">GARANTÍA DE SATISFACCIÓN</textPath></text>
    <text font-size="9.6" letter-spacing="2.6"><textPath href={`#${id}-abajo`} startOffset="50%" text-anchor="middle">REEMBOLSO DEL 100 %</textPath></text>
  </g>
  <!-- Estrellas que separan los dos arcos -->
  {
    [30.5, 169.5].map((x) => (
      <path transform={`translate(${x} 100) scale(0.42)`} d="M0-9 2.6-2.8 9-2.6 4-1.2 5.6 8 0 4-5.6 8-4-1.2-9-2.6-2.6-2.8Z" fill="#4a3208"></path>
    ))
  }

  <!-- Cifra en relieve: una copia clara desplazada debajo hace el canto del estampado -->
  <g font-family="var(--font-display)" font-weight="800" text-anchor="middle">
    <text x="100.7" y="111.2" font-size="58" fill="#fff6cf" opacity="0.9">7</text>
    <text x="100" y="110.4" font-size="58" fill="#4a3208">7</text>
    <text x="100.5" y="128.6" font-size="13" letter-spacing="3.4" fill="#fff6cf" opacity="0.9">DÍAS</text>
    <text x="100" y="128" font-size="13" letter-spacing="3.4" fill="#4a3208">DÍAS</text>
  </g>

  <!-- Brillo diagonal de la lámina -->
  <rect x="0" y="0" width="200" height="200" fill={`url(#${id}-brillo)`} clip-path={`url(#${id}-recorte)`} style="mix-blend-mode: soft-light"></rect>
</svg>
