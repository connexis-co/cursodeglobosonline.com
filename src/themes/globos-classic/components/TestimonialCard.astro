---
/**
 * Reseña REAL citada de la ficha pública de Hotmart (texto literal, nombre tal como
 * lo publica Hotmart y fecha). La fuente se nombra sin enlace: la URL directa del marketplace
 * no lleva el `ref` de afiliado y cada clic ahí era una posible venta sin comisión. Las fichas
 * de curso enlazan las reseñas por el enlace corto con atribución (`buildHotmartProductUrl`). No se marca como schema Review:
 * es un dato de terceros (pautas de review snippet de Google).
 */
import { getEntry, type CollectionEntry } from '@/lib/emdash-content';
import Rating from './Rating.astro';

interface Props {
  testimonial: CollectionEntry<'testimonials'>;
}

const { testimonial } = Astro.props;
const t = testimonial.data;
const course = await getEntry('courses', t.courseSlug);
const AVATAR_COLORS = [
  'oklch(0.55 0.2 15)',
  'oklch(0.55 0.09 210)',
  'oklch(0.52 0.11 302)',
  'oklch(0.58 0.11 70)',
];
const color = AVATAR_COLORS[t.id.charCodeAt(t.id.length - 1) % AVATAR_COLORS.length];
const date = new Intl.DateTimeFormat('es', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(t.date);
---

<figure
  class="flex h-full flex-col gap-4 rounded-2xl border border-crema-200 bg-white p-6"
>
  <div class="flex items-center justify-between gap-3">
    <Rating rating={t.rating} />
    {
      course && (
        <span class="rounded-full bg-coral-50 px-2.5 py-0.5 text-[0.7rem] font-extrabold text-coral-700">
          {course.data.title.replace('Curso de ', '')}
        </span>
      )
    }
  </div>
  <blockquote class="flex-1 text-sm leading-relaxed text-ciruela-600">“{t.text}”</blockquote>
  <figcaption class="flex items-center gap-3">
    <span
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full font-display text-lg font-semibold text-white"
      style={`background:${color}`}
      aria-hidden="true"
    >
      {t.name.charAt(0)}
    </span>
    <span>
      <span class="block text-sm font-extrabold text-ciruela-800">{t.name}</span>
      <span class="block text-xs text-ciruela-500">
        Reseña pública en Hotmart · {date}
      </span>
    </span>
  </figcaption>
</figure>
