---
import { EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui';
import type { PublicPageContext } from 'emdash';
/**
 * Layout mínimo para landings de Ads (§8): sin navegación, sin footer completo,
 * sin enlaces externos salvo el CTA a Hotmart. Siempre noindex.
 */
import '@/styles/global.css';
import FontPreloads from '@/components/FontPreloads.astro';
import TrackingHead from '@/components/TrackingHead.astro';
import BrandSymbol from '@/components/BrandSymbol.astro';
import Seo from '@/components/Seo.astro';
import { GTM_ID } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  pageType: string;
}

const { title, description, pageType } = Astro.props;
const emdashPage:PublicPageContext={url:Astro.url.href,path:Astro.url.pathname,locale:'es',kind:'custom',pageType,title,description,canonical:null,image:null,content:Astro.locals.cmsContent?.contentRef};

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fdf9f4" />
    <Seo {title} {description} noindex />
    <FontPreloads />
    <TrackingHead />
  </head>
  <body data-page-type={pageType}>
<BrandSymbol />
<EmDashBodyStart page={emdashPage} />
    {
      GTM_ID && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <slot />
    <script>
      import { trackEvent } from '@/lib/analytics';
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (!el?.dataset.track) return;
        let params: Record<string, string | number | boolean> = {};
        try {
          params = JSON.parse(el.dataset.trackParams ?? '{}');
        } catch {
          /* ignorar params malformados */
        }
        trackEvent(el.dataset.track, params);
      });
    </script>
  <EmDashBodyEnd page={emdashPage} />
</body>
</html>
