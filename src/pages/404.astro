---
Astro.response.status=404;
import { getCountrySummaries as getCountries } from '@/lib/emdash-content';
const COUNTRIES = await getCountries();
import { getCollection } from '@/lib/emdash-content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CourseCard from '@/components/CourseCard.astro';
import Icon from '@/components/Icon.astro';
import { DEFAULT_COUNTRY } from '@/lib/countries';

// La 404 es estática y no sabe el país del visitante: se genera con el país por defecto y un
// script la ajusta al país que la persona ya eligió (localStorage `cdgo-country`, lo guarda el Header).
const country = COUNTRIES.find((c) => c.code === DEFAULT_COUNTRY)!;
const courses = (await getCollection('courses')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);
/** Rotaciones orgánicas deterministas (sistema: ±0.4–0.9°), se enderezan al hover. */
const TILTS = ['rotate-[-0.6deg]', 'rotate-[0.5deg]', 'rotate-[-0.4deg]', 'rotate-[0.8deg]'];
---

<BaseLayout
  title="Página no encontrada — Curso de Globos Online"
  description="La página que buscas no existe o cambió de dirección."
  pageType="404"
  noindex
>
  <div id="no-encontrada" data-default-cc={DEFAULT_COUNTRY} data-codes={COUNTRIES.map((c) => c.code).join(',')}>
    <section class="contenedor flex flex-col items-center pt-10 pb-14 text-center lg:pt-14">
      <!-- Globo reventado: anatomía de Balloons.astro (látex con luz/base/sombra, nudo con pestaña,
           cuerda en S). Queda el nudo con los flecos del látex; los trozos salen volando. -->
      <svg
        viewBox="0 0 240 232"
        width="240"
        height="232"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="h-auto w-48 sm:w-56"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <radialGradient id="p404-latex" cx="0.34" cy="0.28" r="0.95">
            <stop offset="0%" stop-color="oklch(0.85 0.09 20)"></stop>
            <stop offset="52%" stop-color="oklch(0.62 0.2 14)"></stop>
            <stop offset="100%" stop-color="oklch(0.54 0.17 25)"></stop>
          </radialGradient>
        </defs>
        <!-- silueta del globo que ya no está -->
        <path
          d="M120 26.4C150.5 26.4 173.7 51 173.7 82.9C173.7 110.5 153.4 136.6 130.2 145.8L120 148.4L109.9 145.8C86.7 136.6 66.4 110.5 66.4 82.9C66.4 51 89.6 26.4 120 26.4Z"
          stroke="oklch(0.88 0.06 12)"
          stroke-width="2"
          stroke-dasharray="3 8"
          stroke-linecap="round"></path>
        <!-- estelas del estallido -->
        <g stroke="oklch(0.84 0.145 85)" stroke-width="3" stroke-linecap="round">
          <path d="M97 63.5l-7-6.5"></path>
          <path d="M102.5 57l-4.5-4.5"></path>
          <path d="M145 58l6.5-7"></path>
          <path d="M151.5 64.5l4-4.5"></path>
          <path d="M82 95.5l-11 2.5"></path>
          <path d="M158.5 90l12 1.8"></path>
          <path d="M156 99.5l6.5 1"></path>
        </g>
        <!-- trozos de látex rasgado -->
        <g fill="url(#p404-latex)">
          <path d="M58 40c7-9 19-12 29-7l-6 4 8 4-7 3 3 7c-11 3-22-1-27-11Z"></path>
          <path d="M158 22c11-4 23 1 27 11l-7-1 3 8-8-2v7c-9-3-15-11-15-23Z"></path>
          <path d="M30 98c9-7 21-6 27 2l-7 2 5 6-8 1 1 7c-9-1-16-8-18-18Z"></path>
          <path d="M208 84c6 9 5 21-3 27l-1-8-7 4v-8l-7-1c4-8 10-13 18-14Z"></path>
          <path d="M186 140c9 1 15 7 16 15l-6-2-1 7-5-5-5 4c-2-8-1-14 1-19Z" opacity="0.85"></path>
          <path d="M40 150c4-8 12-11 19-9l-4 5 6 3-6 3 2 6c-8 0-14-3-17-8Z" opacity="0.85"></path>
        </g>
        <!-- confeti -->
        <circle cx="84" cy="18" r="3" fill="oklch(0.78 0.1 193)"></circle>
        <circle cx="204" cy="60" r="2.6" fill="oklch(0.74 0.1 303)"></circle>
        <circle cx="24" cy="64" r="2.4" fill="oklch(0.84 0.145 85)"></circle>
        <rect x="170" y="112" width="6" height="3" rx="1.5" transform="rotate(-30 173 113.5)" fill="oklch(0.78 0.1 193)"></rect>
        <rect x="62" y="124" width="6" height="3" rx="1.5" transform="rotate(35 65 125.5)" fill="oklch(0.74 0.1 303)"></rect>
        <!-- flecos del látex que quedaron pegados al nudo -->
        <path
          d="M120 148C113 145 107.5 140 105 133L110.5 135.5L107 124L114 131L116.5 119L121 129.5L126.5 120.5L127.5 132L133.5 126L133 136C130.5 142 125.5 146 120 148Z"
          fill="url(#p404-latex)"></path>
        <!-- nudo con pestaña + cuerda en S -->
        <path d="M120 146.7c-7.5 4.6-10.4 9.3-8.7 13.9h17.4c1.7-4.6-1.2-9.3-8.7-13.9Z" fill="oklch(0.54 0.17 25)"></path>
        <ellipse cx="120" cy="160.2" rx="9" ry="3.2" fill="oklch(0.54 0.17 25)" opacity="0.85"></ellipse>
        <path
          d="M120 162.8q-11.6 20.3 1.5 34.8q10.2 13-2.9 18.9"
          stroke="oklch(0.55 0.035 295)"
          stroke-opacity="0.6"
          stroke-width="2.2"
          stroke-linecap="round"></path>
      </svg>

      <h1 class="mt-4 text-4xl font-semibold text-ciruela-900">¡Se nos reventó este globo!</h1>
      <p class="mx-auto mt-3 max-w-md text-sm text-ciruela-500">
        La página que buscas no existe o cambió de dirección con el sitio nuevo. Lo bueno: los cursos siguen
        aquí, inflados y listos.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="/"
          class="rounded-xl bg-coral-600 px-7 py-3.5 text-sm font-bold text-white shadow-boton transition-all duration-300 ease-fiesta hover:-translate-y-0.5 hover:bg-coral-700"
        >
          Ir al inicio
        </a>
        <a
          href={`/${country.code}/cursos/`}
          data-country-aware
          class="rounded-xl border-2 border-crema-300 px-7 py-3.5 text-sm font-bold text-ciruela-600 transition-colors hover:border-coral-300 hover:text-coral-600"
        >
          Ver los cursos
        </a>
      </div>
    </section>

    <!-- Accesos directos a los cursos (URL canónica curso-país, igual que el resto del sitio) -->
    <section class="contenedor pb-16" aria-labelledby="no-encontrada-cursos">
      <p class="text-xs font-extrabold tracking-[0.22em] text-coral-600 uppercase">Nuestros cursos</p>
      <h2 id="no-encontrada-cursos" class="mt-2 text-3xl font-semibold text-ciruela-900">
        Elige por cuál seguir
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-country-aware>
        {
          courses.map((course, i) => (
            <div
              class:list={[
                TILTS[i % TILTS.length],
                'transition-[rotate] duration-500 ease-fiesta *:h-full hover:rotate-0 focus-within:rotate-0',
              ]}
            >
              <CourseCard {course} {country} />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Países -->
    <section class="border-t border-crema-200 bg-crema-100 py-10" aria-labelledby="no-encontrada-paises">
      <div class="contenedor">
        <h2 id="no-encontrada-paises" class="flex items-center gap-2 text-xl font-semibold text-ciruela-900">
          <Icon name="mundo" size={22} class="text-coral-600" />
          Cursos en tu país
        </h2>
        <ul class="mt-5 flex flex-wrap gap-2.5">
          {
            COUNTRIES.map((c) => (
              <li>
                <a
                  href={`/${c.code}/`}
                  data-country-link={c.code}
                  class="inline-flex min-h-11 items-center gap-2 rounded-full border border-crema-300 bg-white px-4 text-sm font-semibold text-ciruela-700 transition-colors hover:border-coral-300 hover:text-coral-700"
                >
                  <span aria-hidden="true">{c.flag}</span>
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Enlaces al país que el visitante ya eligió (misma clave que usa el Header).
  const root = document.getElementById('no-encontrada');
  const fallback = root?.dataset.defaultCc ?? 'co';
  const codes = (root?.dataset.codes ?? '').split(',');
  let saved: string | null = null;
  try {
    saved = localStorage.getItem('cdgo-country');
  } catch {
    /* almacenamiento bloqueado: se quedan los enlaces por defecto */
  }
  if (root && saved && saved !== fallback && codes.includes(saved)) {
    const prefix = `/${fallback}/`;
    root
      .querySelectorAll<HTMLAnchorElement>('a[data-country-aware], [data-country-aware] a')
      .forEach((a) => {
        const href = a.getAttribute('href') ?? '';
        if (href.startsWith(prefix)) a.setAttribute('href', `/${saved}/${href.slice(prefix.length)}`);
      });
  }
</script>
