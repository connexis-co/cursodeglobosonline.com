---
import {FIXED_PAGE_PATHS} from '@/plugins/globos-integrity/model';
const fixed=FIXED_PAGE_PATHS[Astro.params.slug!];if(fixed)return Astro.redirect(fixed,301);
import {getDocument} from '@/lib/emdash-content';
import EditorialPage from '@/themes/globos-classic/components/EditorialPage.astro';
const page=await getDocument('pages',Astro.params.slug!);if(!page)return Astro.rewrite('/404');
---
<EditorialPage {page} />
