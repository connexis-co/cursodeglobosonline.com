---
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import RichBody from '@/components/RichBody.astro';
import { getDocument } from '@/lib/emdash-content';
const [page,COUNTRIES,courseEntries,testimonialEntries,posts]=await Promise.all([getDocument('pages','inicio'),getCountries(),getCollection('courses'),getCollection('testimonials'),getRecentBlogPosts(3)]);if(!page)return Astro.rewrite('/404');Astro.locals.cmsContent=page;
const copy=page.data;
import { getCountrySummaries as getCountries } from '@/lib/emdash-content';

import { getCollection } from '@/lib/emdash-content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Balloons from '@/components/Balloons.astro';
import Wave from '@/components/Wave.astro';
import TrustBar from '@/components/TrustBar.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CourseCard from '@/components/CourseCard.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import CertificateShowcase from '@/components/CertificateShowcase.astro';
import LeadForm from '@/components/LeadForm.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { getRecentBlogPosts } from '@/lib/emdash-content';
import { DEFAULT_COUNTRY } from '@/lib/countries';
import { buildWhatsAppUrl } from '@/lib/hotmart';
import type { IconName } from '@/lib/icons';
import { countryAlternates, faqSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';

const courses = courseEntries.sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);
const featured = courses.find((c) => c.data.featured) ?? courses[0];
const others = courses.filter((c) => c.id !== featured?.id);
// Reseñas reales de Hotmart (sustituyen a los testimonios placeholder del lanzamiento).
const testimonials = testimonialEntries.slice(0, 6);
// Las 3 guías más recientes del blog: enlazado interno home → blog (clusters informacionales).
// La sección solo se pinta si hay artículos publicados.
const guias = posts.slice(0, 3);

// Tarjeta de asesoría que llena la celda libre del grid de cursos (fila 2, col. 3 en lg).
const defaultCountry = COUNTRIES.find((c) => c.code === DEFAULT_COUNTRY)!;
const waAsesoria = buildWhatsAppUrl(
  defaultCountry.whatsapp,
  'Hola 🎈 No sé qué curso de globos elegir. ¿Me ayudan a escoger?',
);

const metodo=(copy.method??[]) as {icon:IconName;title:string;text:string}[];
const faqs=(copy.faqs??[]) as {q:string;a:string}[];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  alternates={await countryAlternates('/')}
  schemas={[faqSchema(faqs)]}
  pageType="home"
  transparentHeader
>
  <!-- 1 · HERO -->
  <!-- Sin «glows» blur-3xl (P1-7): la fiesta la ponen los globos y la onda. -->
  <section class="relative overflow-hidden bg-ciruela-900 text-crema-50">
    <Balloons variant="hero" />

    <div class="contenedor relative pt-14 pb-20 text-center sm:pt-16 lg:pt-20 lg:pb-28">
      <p
        class="mx-auto inline-flex items-center gap-2 rounded-full border border-crema-50/20 bg-crema-50/10 px-4 py-1.5 text-xs font-bold tracking-wide backdrop-blur-sm"
      >
        {courses.length} cursos · {SITE.stats.students} estudiantes certificados · {SITE.stats.ventures} emprendimientos
      </p>
      <h1
        class="mx-auto mt-6 max-w-3xl text-4xl font-semibold text-balance sm:text-5xl lg:text-6xl"
      >
        {copy.heading} <span class="text-coral-300">{copy.highlight}</span>
      </h1>
      <p
        class="mx-auto mt-5 max-w-xl text-base text-crema-100/85 sm:text-lg"
      >
        {copy.lead}
      </p>
      <div
        class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row"
      >
        <a
          href="/co/cursos/"
          class="rounded-xl bg-coral-600 px-8 py-4 text-sm font-bold text-white shadow-boton transition-all duration-300 ease-fiesta hover:-translate-y-1 hover:bg-coral-700"
        >
          {copy.ctaLabel}
        </a>
        <a
          href={featured?`/co/${featured.id}/`:'/co/cursos/'}
          class="inline-flex items-center justify-center gap-2.5 rounded-xl border-2 border-crema-50/30 px-5 py-4 text-sm font-bold whitespace-nowrap backdrop-blur-sm transition-all duration-300 hover:border-sol-300 hover:text-sol-300 min-[360px]:px-8"
        >
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-sol-300 text-ciruela-900">
            <Icon name="etiqueta" size={14} />
          </span>
          {featured?.data.title??'Ver los cursos'}
        </a>
      </div>
      <p class="mt-7 text-xs text-crema-100/60">
        Garantía de 7 días · Pago seguro con Hotmart · Aprende desde tu celular
      </p>
    </div>
    <Wave color="var(--color-crema-50)" />
  </section>

  <!-- 2 · BARRA DE CONFIANZA -->
  <TrustBar />

  <!-- 3 · CURSOS DESTACADOS (grid asimétrico) -->
  <section class="contenedor py-16 lg:py-24" id="cursos">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="Catálogo"
        title={copy.catalogTitle}
        lead={copy.catalogLead}
      />
      <a
        href="/co/cursos/"
        class="scroll-reveal mb-1 inline-flex shrink-0 items-center gap-1 rounded-xl border-2 border-coral-600 px-5 py-2.5 text-xs font-bold text-coral-600 transition-colors hover:bg-coral-600 hover:text-white"
      >
        Ver todos <Icon name="flecha" size={14} />
      </a>
    </div>
    <!-- Con 4 cursos: destacada (2 filas) + 3 tarjetas + asesoría = grid lleno en lg (3 col.)
         y en sm (2 col.). Todas las tarjetas llevan h-full para igualar alturas por fila. -->
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="scroll-reveal sm:col-span-2 lg:col-span-1 lg:row-span-2">
        {featured&&<CourseCard course={featured} large class="h-full" />}
      </div>
      {
        others.map((course, i) => (
          <div class="scroll-reveal" style={`animation-delay:${i * 70}ms`}>
            <CourseCard course={course} class="h-full" />
          </div>
        ))
      }
      <div class="scroll-reveal" style={`animation-delay:${others.length * 70}ms`}>
        <div
          class="flex h-full flex-col rounded-3xl border-2 border-dashed border-coral-200 bg-coral-50 p-6 transition-transform duration-300 ease-suave hover:rotate-0 sm:rotate-[-0.6deg]"
        >
          <p class="text-[0.7rem] font-extrabold tracking-[0.18em] text-coral-700 uppercase">Asesoría gratis</p>
          <h3 class="mt-2 font-display text-xl font-semibold text-ciruela-900">¿No sabes cuál elegir?</h3>
          <p class="mt-2 text-sm leading-relaxed text-ciruela-600">
            Te asesoramos por WhatsApp según lo que quieras hacer:
          </p>
          <ul class="mt-3 space-y-2 text-sm text-ciruela-700">
            <li class="flex gap-2">
              <Icon name="globo" size={15} class="mt-0.5 text-coral-600" />
              <span>Animación de fiestas: <strong class="font-extrabold">Globoflexia</strong></span>
            </li>
            <li class="flex gap-2">
              <Icon name="globo" size={15} class="mt-0.5 text-coral-600" />
              <span>Arreglos y detalles: <strong class="font-extrabold">Bouquets</strong></span>
            </li>
            <li class="flex gap-2">
              <Icon name="globo" size={15} class="mt-0.5 text-coral-600" />
              <span>Eventos premium: <strong class="font-extrabold">Flores o Globos Burbuja</strong></span>
            </li>
          </ul>
          <div class="mt-auto pt-5">
            <a
              href={waAsesoria}
              target="_blank"
              rel="noopener"
              data-track="click_whatsapp"
              data-track-params={JSON.stringify({ page_location: Astro.url.pathname, placement: 'grid_asesoria' })}
              class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-ciruela-900 px-5 text-sm font-bold text-crema-50 transition-all duration-300 ease-fiesta hover:-translate-y-0.5 hover:bg-ciruela-700"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="shrink-0 text-[#25d366]" aria-hidden="true">
                <path
                  d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.3-.7.8-.8 1-.1.2-.3.2-.6.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.6-1.3 0-.2 0-.3-.1-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s1 2.6 1.1 2.7c.1.2 1.9 2.9 4.6 4.1.6.3 1.1.4 1.5.6.6.2 1.2.2 1.6.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.2-.3-.2-.7-.4Z"
                ></path>
              </svg>
              Escríbenos por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · MÉTODO / SHOWCASE -->
  <section class="relative overflow-hidden bg-ciruela-900 text-crema-50">
    <Wave color="var(--color-crema-50)" flip class="rotate-180" />
    <div class="contenedor grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24">
      <div class="scroll-reveal">
        <p class="mb-2 text-xs font-extrabold tracking-[0.22em] text-sol-300 uppercase">El método</p>
        <h2 class="text-3xl font-semibold text-balance sm:text-4xl">
          De tu primera figura a tu primer evento cobrado
        </h2>
        <!-- Iconos SVG propios (sin emojis) ensartados en un hilo discontinuo, como globos en su
             cuerda: evita la fila de cuadrados iguales de plantilla (P1-6). -->
        <ul
          class="relative mt-8 space-y-5 before:absolute before:top-4 before:bottom-4 before:left-[21px] before:border-l-2 before:border-dashed before:border-crema-50/15"
        >
          {
            metodo.map(({ icon, title, text }) => (
              <li class="relative flex gap-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ciruela-800 text-sol-300 ring-1 ring-crema-50/15">
                  <Icon name={icon} size={20} />
                </span>
                <span>
                  <span class="block font-bold">{title}</span>
                  <span class="mt-0.5 block text-sm text-crema-100/70">{text}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <a
          href={featured?`/co/${featured.id}/`:'/co/cursos/'}
          class="mt-9 inline-block rounded-xl bg-white px-7 py-3.5 text-sm font-bold text-ciruela-900 transition-all duration-300 ease-fiesta hover:-translate-y-0.5 hover:bg-sol-300"
        >
          Ver el curso de globoflexia
        </a>
      </div>
      <div class="scroll-reveal-late relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="rotate-2 overflow-hidden rounded-3xl border-4 border-crema-50/15 shadow-globo">
          <ResponsiveImage sizes="(min-width: 1200px) 560px, (min-width: 1024px) 50vw, (min-width: 448px) 448px, calc(100vw - 48px)" maxWidth={1280}
            src="/images/decoracion-guirnalda.jpg"
            alt="Guirnalda orgánica de globos en tonos coral, crema y dorado decorando un salón de eventos"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
            decoding="async"
            width="1100"
            height="825"
          />
        </div>
        <div
          class="absolute -bottom-5 -left-4 rotate-[-3deg] rounded-2xl bg-crema-50 px-5 py-3 text-ciruela-800 shadow-globo"
        >
          <span class="block font-display text-2xl font-semibold text-coral-600">{SITE.stats.supportVideos}</span>
          <span class="block text-xs font-bold">videos de apoyo</span>
        </div>
        <div
          class="absolute -top-5 -right-3 rotate-3 rounded-2xl bg-sol-300 px-5 py-3 text-ciruela-900 shadow-globo"
        >
          <span class="block font-display text-2xl font-semibold">50%</span>
          <span class="block text-xs font-bold">OFF globoflexia</span>
        </div>
      </div>
    </div>
    <Wave color="var(--color-crema-50)" />
  </section>

  <!-- 5 · CÓMO FUNCIONA -->
  <section class="contenedor py-16 lg:py-24">
    <SectionHeading
      eyebrow="Cómo funciona"
      title="Tres pasos y estás practicando hoy mismo"
      align="center"
    />
    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        [
          ['1', 'Inscríbete en Hotmart', 'Pago seguro con tarjeta o métodos locales de tu país, en tu moneda. El acceso llega a tu correo al instante.'],
          ['2', 'Aprende a tu ritmo', 'Videos paso a paso desde tu celular o computador, con tareas calificadas y asistencia académica.'],
          ['3', 'Certifícate y cobra', 'Descarga tu certificado de estudios, arma tu portafolio y empieza a cotizar tus primeros pedidos.'],
        ].map(([num, title, text], i) => (
          <div
            class:list={[
              'scroll-reveal relative rounded-3xl border border-crema-200 bg-white p-7 shadow-tarjeta',
              i === 1 && 'sm:translate-y-5 sm:rotate-[0.5deg]',
              i === 0 && 'sm:rotate-[-0.6deg]',
              i === 2 && 'sm:rotate-[-0.4deg] sm:translate-y-2',
            ]}
            style={`animation-delay:${i * 90}ms`}
          >
            <span class="font-display absolute -top-6 left-6 text-6xl font-bold text-coral-200" aria-hidden="true">
              {num}
            </span>
            <h3 class="relative mt-4 text-lg font-extrabold text-ciruela-900">{title}</h3>
            <p class="relative mt-2 text-sm leading-relaxed text-ciruela-500">{text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 6 · TESTIMONIOS -->
  <section class="bg-crema-100 py-16 lg:py-24">
    <div class="contenedor">
      <SectionHeading
        eyebrow="Reseñas reales"
        title="Lo que escriben las alumnas en Hotmart"
        lead="Citas textuales de la ficha pública de cada curso en Hotmart, la plataforma donde se compra y se estudia."
      />
      <!-- Móvil: carrusel con scroll-snap (antes 6 tarjetas apiladas ≈ 1.500 px). Desde sm, grid. -->
      <p class="mt-6 inline-flex items-center gap-1 text-xs font-bold text-ciruela-500 sm:hidden">
        Desliza para ver las {testimonials.length} reseñas <Icon name="flecha" size={14} />
      </p>
      <div
        class="scroll-reveal -mx-5 mt-3 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 py-3 [scrollbar-width:none] sm:mx-0 sm:mt-10 sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:p-0 lg:grid-cols-3 [&::-webkit-scrollbar]:hidden [&>*]:w-[85%] [&>*]:shrink-0 [&>*]:snap-start sm:[&>*]:w-auto"
      >
        {
          testimonials.map((t) => (
            <div>
              <TestimonialCard testimonial={t} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 7 · CERTIFICADO -->
  <section class="contenedor grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24">
    <CertificateShowcase courseName={featured?.data.title??'Decoración con globos'} />
    <div class="scroll-reveal">
      <SectionHeading
        eyebrow="Certificado"
        title="Un certificado que respalda tu trabajo"
        lead="Al completar el 100% de las lecciones recibes un certificado de estudios digital con validez internacional."
      />
      <ul class="mt-7 space-y-3.5 text-sm text-ciruela-600">
        {
          [
            'Incluye tu nombre, el curso completado y la fecha',
            'Verificable en línea, listo para compartir en redes o imprimir',
            'Con tareas calificadas y asistencia académica durante el curso',
            'Súmalo a tu portafolio para cotizar con más confianza',
          ].map((item) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 shrink-0 text-coral-500" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="10" fill="currentColor" opacity="0.15" />
                <path d="m8 12.5 2.7 2.7L16.5 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8 · LEAD FORM -->
  <section class="relative overflow-hidden bg-crema-100 py-16 lg:py-24">
    <Balloons variant="rise" />
    <div class="contenedor relative grid items-center gap-10 lg:grid-cols-[1fr_1.2fr]">
      <SectionHeading
        eyebrow="Asesoría"
        title="Te ayudamos a elegir tu curso"
        lead="Cuéntanos qué quieres aprender y te respondemos por WhatsApp con la información completa: temario, precio en tu moneda y cómo inscribirte."
      />
      <LeadForm courses={courses} />
    </div>
  </section>

  <!-- 9 · FAQ -->
  <section class="contenedor max-w-4xl py-16 lg:py-24">
    <SectionHeading eyebrow="Preguntas frecuentes" title="Lo que todos preguntan antes de empezar" align="center" />
    <div class="mt-10">
      <FaqAccordion faqs={faqs} />
    </div>
  </section>

  <!-- 10 · GUÍAS GRATIS DEL BLOG (solo si hay artículos publicados). Con 3 guías: carrusel
       snap-x hasta lg (a 2 columnas quedaría una huérfana) y grid de 3 en lg. -->
  {
    guias.length > 0 && (
      <section class="bg-crema-100 py-16 lg:py-24">
        <div class="contenedor">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <SectionHeading
              eyebrow="Guías gratis del blog"
              title="Practica gratis mientras eliges tu curso"
              lead="Artículos paso a paso con medidas, cantidades y costos de referencia. Cada guía te dice qué curso lo enseña completo, en video y con certificado."
            />
            <a
              href="/blog/"
              class="scroll-reveal mb-1 inline-flex shrink-0 items-center gap-1.5 rounded-xl border-2 border-coral-600 px-5 py-2.5 text-xs font-bold text-coral-600 transition-colors hover:bg-coral-600 hover:text-white"
            >
              Ver todas las guías
              <Icon name="flecha" size={14} />
            </a>
          </div>
          {guias.length === 1 ? (
            <div class="scroll-reveal mt-10">
              <PostCard post={guias[0]} featured />
            </div>
          ) : guias.length === 2 ? (
            <div class="scroll-reveal mt-10 grid gap-6 sm:grid-cols-2">
              {guias.map((p) => (
                <PostCard post={p} />
              ))}
            </div>
          ) : (
            <div class="scroll-reveal -mx-5 mt-7 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 py-3 [scrollbar-width:none] sm:-mx-8 sm:scroll-px-8 sm:px-8 lg:mx-0 lg:mt-10 lg:grid lg:grid-cols-3 lg:gap-6 lg:overflow-visible lg:p-0 [&::-webkit-scrollbar]:hidden [&>*]:w-[85%] [&>*]:shrink-0 [&>*]:snap-start sm:[&>*]:w-[46%] lg:[&>*]:w-auto">
              {guias.map((p) => (
                <PostCard post={p} />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- 11 · CTA FINAL: fondo tinta sólido (antes degradado coral→lila, 2.4:1 en el extremo lila).
       Un paso más claro que el footer (ciruela-900) y con onda hacia él, para que no se fundan. -->
  <section class="relative overflow-hidden bg-ciruela-800 text-crema-50">
    <Wave color={guias.length > 0 ? 'var(--color-crema-100)' : 'var(--color-crema-50)'} flip />
    <Balloons variant="rise" />
    <div class="contenedor relative py-14 text-center lg:py-20">
      <h2 class="mx-auto max-w-2xl text-3xl font-semibold text-balance sm:text-4xl">
        Tu primer montaje cobrado está a un curso de distancia
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-sm text-crema-100/80 sm:text-base">
        Únete a los {SITE.stats.students} estudiantes certificados que ya convirtieron los globos en ingresos.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={featured?`/co/${featured.id}/`:'/co/cursos/'}
          class="rounded-xl bg-coral-600 px-8 py-4 text-sm font-bold text-white shadow-boton transition-all duration-300 ease-fiesta hover:-translate-y-1 hover:bg-coral-700"
        >
          Empezar con Globoflexia (50% OFF)
        </a>
        <a
          href="/co/cursos/"
          class="rounded-xl border-2 border-crema-50/40 px-8 py-4 text-sm font-bold text-crema-50 transition-colors hover:border-sol-300 hover:text-sol-300"
        >
          Ver todos los cursos
        </a>
      </div>
    </div>
    <Wave color="var(--color-ciruela-900)" />
  </section>
{page.richBody.length>0&&<section class="contenedor articulo py-12"><RichBody value={page.richBody}/></section>}
</BaseLayout>
