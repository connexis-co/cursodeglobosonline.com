---
import { getEntry } from '@/lib/emdash-content';
import RichBody from '@/themes/globos-classic/components/RichBody.astro';
import { richHeadings } from '@/lib/rich-text';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import CourseCta from '@/components/blog/CourseCta.astro';
import Callout from '@/components/blog/Callout.astro';
import Toc from '@/components/blog/Toc.astro';
import AuthorBox from '@/components/blog/AuthorBox.astro';
import StarRating from '@/components/StarRating.astro';
import BlogRating from '@/themes/globos-classic/components/blog/BlogRating.astro';
import { getBlogRating } from '@/lib/ratings';
import BlogComments from '@/themes/globos-classic/components/blog/BlogComments.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { getPublishedPosts, relatedPosts, readingMinutes, formatDate, lastModified, type Post } from '@/lib/blog';
import { getBlogCluster } from '@/lib/emdash-content';
import { getAuthor } from '@/lib/emdash-content';
import { blogPostingSchema, breadcrumbSchema, faqSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';



interface Props {
  post: Post;
  all: Post[];
}

const post=await getEntry('blog',Astro.params.slug!);
if(!post)return Astro.rewrite('/404');
const all=await getPublishedPosts();
Astro.locals.cmsContent=post as unknown as App.Locals["cmsContent"];
const d = post.data;
const postRating = await getBlogRating(post.contentRef.id);
const headings = richHeadings(post.richBody);
const cluster = await getBlogCluster(d.cluster);
const author = await getAuthor(d.author);
const url = `${SITE.url}/blog/${post.id}/`;
const modified = lastModified(post);
const minutes = readingMinutes(post);
const pillar = d.pillar ? all.find((p) => p.id === d.pillar) : undefined;
const related = relatedPosts(post, all, 3);

// El CMS sirve el original: las variantes requieren un servicio de imágenes configurado.
const abs = (src: string) => new URL(src, SITE.url).href;

const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const schemas = [
  blogPostingSchema({
    url,
    headline: d.title,
    description: d.description,
    images: [abs(d.hero.src)],
    datePublished: d.publishedAt,
    dateModified: modified,
    author,
    section: cluster.name,
    keywords: d.keywords,
    wordCount,
  }),
  breadcrumbSchema([
    { name: 'Inicio', url: `${SITE.url}/` },
    { name: 'Blog', url: `${SITE.url}/blog/` },
    { name: d.title, url },
  ]),
  ...(d.faqs.length > 0 ? [faqSchema(d.faqs)] : []),
];

const trackParams = JSON.stringify({
  post_slug: post.id,
  post_cluster: d.cluster,
  money_page: d.moneyPage,
  is_pillar: d.isPillar,
});
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.description}
  {schemas}
  pageType="blog_post"
  whatsappContext={d.title}
  ogTitle={d.discoverTitle ?? d.title}
  ogType="article"
  ogImage={d.hero.src}
  ogImageWidth={d.hero.width}
  ogImageHeight={d.hero.height}
  ogImageAlt={d.heroAlt}
  article={{
    publishedTime: d.publishedAt,
    modifiedTime: modified,
    author: author.name,
    section: cluster.name,
    tags: d.keywords.slice(0, 6),
  }}
>
  <script
    is:inline
    set:html={`window.dataLayer=window.dataLayer||[];window.dataLayer.push(Object.assign({event:'view_blog_post',page_type:'blog_post'},${trackParams}));`}
  />

  <div class="contenedor pt-6 pb-20 lg:pt-10">
    <nav aria-label="Migas de pan" class="text-xs text-ciruela-400">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-coral-600">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/blog/" class="hover:text-coral-600">Blog</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/blog/#${cluster.slug}`} class="hover:text-coral-600">{cluster.name}</a></li>
      </ol>
    </nav>

    <header class="mt-5 max-w-3xl">
      <p class="text-xs font-extrabold tracking-[0.2em] text-coral-600 uppercase">
        {d.isPillar ? `Guía completa · ${cluster.name}` : cluster.name}
      </p>
      <h1 class="mt-3 text-[2.1rem] leading-[1.08] font-semibold text-ciruela-900 sm:text-5xl">{d.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ciruela-500">{d.description}</p>
      <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ciruela-500">
        <a href={`/blog/autor/${author.slug}/`} rel="author" class="font-bold text-ciruela-700 hover:text-coral-600">
          {author.name}
        </a>
        <span aria-hidden="true">·</span>
        {
          d.updatedAt ? (
            <span>
              Actualizado el <time datetime={modified.toISOString()}>{formatDate(modified)}</time>
            </span>
          ) : (
            <span>
              <time datetime={d.publishedAt.toISOString()}>{formatDate(d.publishedAt)}</time>
            </span>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{minutes} min de lectura</span>
      </div>
      <a href="#calificar-articulo" class="mt-4 inline-flex rounded-lg underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-coral-600"><BlogRating contentId={post.contentRef.id}/></a>
    </header>

    <figure class="mt-8 overflow-hidden rounded-3xl bg-crema-200 shadow-tarjeta">
      <img
        src={d.hero.src}
        width={d.hero.width}
        height={d.hero.height}
        alt={d.heroAlt}
        loading="eager"
        fetchpriority="high"
        class="aspect-[16/9] w-full object-cover"
      />
    </figure>

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_17rem] xl:gap-16">
      <div class="min-w-0">
        <div class="mb-8 lg:hidden">
          <Toc {headings} collapsible />
        </div>

        <div class="articulo">
          <RichBody value={post.richBody} />
        </div>

        {
          d.faqs.length > 0 && (
            <section class="mt-14" aria-labelledby="faq-titulo">
              <h2 id="faq-titulo" class="mb-6 text-2xl font-semibold text-ciruela-900 sm:text-3xl">
                Preguntas frecuentes
              </h2>
              <FaqAccordion faqs={d.faqs} />
            </section>
          )
        }

        <CourseCta curso={d.moneyPage} />

        {
          pillar && (
            <p class="mb-8 rounded-2xl border border-crema-200 bg-white px-5 py-4 text-sm text-ciruela-600">
              Esta guía es parte de{' '}
              <a href={`/blog/${pillar.id}/`} class="font-bold text-coral-600 underline-offset-2 hover:underline">
                {pillar.data.title}
              </a>
              , nuestra guía completa sobre {cluster.name.toLowerCase()}.
            </p>
          )
        }

        <AuthorBox {author} />
        <section id="calificar-articulo" aria-labelledby="calificar-titulo" class="mt-10 scroll-mt-28 rounded-3xl border border-crema-200 bg-white p-6 sm:p-8">
          <h2 id="calificar-titulo" class="text-2xl font-semibold text-ciruela-900">¿Te resultó útil esta guía?</h2>
          <p class="mt-2 mb-5 text-sm text-ciruela-600">Tu valoración nos ayuda a mejorar los próximos artículos.</p>
          <StarRating contentId={post.contentRef.id} contentTitle={d.title} kind="blog" rating={postRating} size="lg" prompt="Valora el artículo de 1 a 5 estrellas"/>
        </section>
        <BlogComments contentId={post.contentRef.id} />
      </div>

      <aside class="hidden lg:block" aria-label="Navegación del artículo">
        <div class="sticky top-28 space-y-8">
          <Toc {headings} />
          <CourseCta curso={d.moneyPage} variante="compacta" texto={d.moneyAnchor} />
        </div>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="mt-20" aria-labelledby="relacionados-titulo">
          <h2 id="relacionados-titulo" class="text-2xl font-semibold text-ciruela-900 sm:text-3xl">
            Sigue leyendo
          </h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  // Resalta en el TOC la sección visible (sin librerías).
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [a.dataset.tocLink!, a]),
  );
  if (links.size > 0 && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('aria-current'));
          links.get(entry.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    document.querySelectorAll('.articulo h2[id]').forEach((h) => io.observe(h));
  }
</script>
