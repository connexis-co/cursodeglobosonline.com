---
/**
 * Ruta dual /{cc}/{item}/ — `item` puede ser un slug de curso
 * (/co/curso-de-globoflexia/) o una ciudad (/co/bogota/). Patrón [item] del
 * ecosistema Sably para evitar colisión de rutas dinámicas al mismo nivel.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import CourseLanding from '@/components/CourseLanding.astro';
import CityLanding from '@/components/CityLanding.astro';
import { COUNTRIES, CITIES_ENABLED, type Country, type City } from '@/lib/countries';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return COUNTRIES.flatMap((country) => [
    ...courses.map((course) => ({
      params: { country: country.code, item: course.id },
      props: { country, course, city: undefined },
    })),
    ...(CITIES_ENABLED
      ? country.cities.map((city) => ({
          params: { country: country.code, item: city.slug },
          props: { country, course: undefined, city },
        }))
      : []),
  ]);
}

interface Props {
  country: Country;
  course?: CollectionEntry<'courses'>;
  city?: City;
}

const { country, course, city } = Astro.props;
---

{course ? <CourseLanding {country} {course} /> : <CityLanding {country} city={city!} />}
