---
import { getCountries } from '@/lib/emdash-content';
const COUNTRIES = await getCountries();
/**
 * Curso hiperlocal: /{cc}/{ciudad}/{curso-slug}/ (§6.2 del plan maestro).
 * Recupera las URLs geo del sitio anterior (/bogota/curso-de-globoflexia/ →
 * /co/bogota/curso-de-globoflexia/) con contenido local único por ciudad.
 */
import { getCourse, getCollection } from '@/lib/emdash-content';
import CourseLanding from '@/components/CourseLanding.astro';
import { CITIES_ENABLED } from '@/lib/countries';



const country=COUNTRIES.find(c=>c.code===Astro.params.country);
const city=country?.cities.find(c=>c.slug===Astro.params.item);
const course=await getCourse(Astro.params.curso!);
if(!country||!city||!course)return Astro.rewrite('/404');
---

<CourseLanding {country} {city} {course} />
