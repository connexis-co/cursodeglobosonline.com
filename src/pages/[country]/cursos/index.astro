---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CourseCard from '@/components/CourseCard.astro';
import { COUNTRIES } from '@/lib/countries';
import { CATEGORIES } from '@/lib/categories';
import { countryAlternates, breadcrumbSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';

export function getStaticPaths() {
  return COUNTRIES.map((country) => ({ params: { country: country.code }, props: { country } }));
}

const { country } = Astro.props;
const courses = (await getCollection('courses')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);
const activeCategories = CATEGORIES.filter((cat) => courses.some((c) => c.data.category === cat.slug));
---

<BaseLayout
  title={`Cursos de Globos Online en ${country.name}: Catálogo y Precios`}
  description={`Compara los 4 cursos de globos: globoflexia (50% OFF), bouquets, flores y globos burbuja. Temario, número de clases, precio y certificado de cada uno.`}
  {country}
  pathAfterCountry="/cursos/"
  alternates={countryAlternates('/cursos/')}
  schemas={[
    breadcrumbSchema([
      { name: 'Inicio', url: `${SITE.url}/${country.code}/` },
      { name: 'Cursos', url: `${SITE.url}/${country.code}/cursos/` },
    ]),
  ]}
  pageType="catalog"
>
  <div class="contenedor pt-10 pb-16 lg:pt-12 lg:pb-24">
    <nav class="mb-6 text-xs text-ciruela-400" aria-label="Miga de pan">
      <a href={`/${country.code}/`} class="hover:text-coral-600">{country.flag} {country.name}</a>
      <span aria-hidden="true"> / </span>
      <span class="font-bold text-ciruela-600">Cursos</span>
    </nav>

    <SectionHeading as="h1"
      eyebrow="Catálogo completo"
      title={`Todos los cursos de decoración con globos`}
      lead={`Técnicas paso a paso con certificado de estudios y acceso permanente. Los precios se muestran en ${country.currency} y el pago es seguro con Hotmart.`}
    />

    <div class="mt-8 flex flex-wrap gap-2">
      <span class="rounded-full bg-coral-500 px-4 py-2 text-xs font-extrabold text-white">Todos</span>
      {
        activeCategories.map((cat) => (
          <a
            href={`/${country.code}/cursos/${cat.slug}/`}
            class="rounded-full border border-crema-300 bg-white px-4 py-2 text-xs font-bold text-ciruela-600 transition-colors hover:border-coral-300 hover:text-coral-600"
          >
            {cat.emoji} {cat.name}
          </a>
        ))
      }
    </div>

    <div id="catalogo" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        courses.map((course, i) => (
          <div class="scroll-reveal curso-item" data-title={course.data.title.toLowerCase()} style={`animation-delay:${i * 60}ms`}>
            <CourseCard {course} {country} />
          </div>
        ))
      }
    </div>
    <p id="sin-resultados" class="mt-10 hidden text-center text-sm text-ciruela-400">
      No encontramos cursos con ese nombre. Escríbenos por WhatsApp y te ayudamos a elegir. 🎈
    </p>
  </div>

  <script>
    // Filtro simple ?q= desde el buscador del menú mobile
    const q = new URLSearchParams(location.search).get('q')?.toLowerCase().trim();
    if (q) {
      const items = document.querySelectorAll<HTMLElement>('.curso-item');
      let visible = 0;
      items.forEach((item) => {
        const match = (item.dataset.title ?? '').includes(q);
        item.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (visible === 0) document.getElementById('sin-resultados')?.classList.remove('hidden');
    }
  </script>
</BaseLayout>
