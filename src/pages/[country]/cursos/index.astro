---
import { getCategories } from '@/lib/emdash-content';
const CATEGORIES = await getCategories();
import { getCountries } from '@/lib/emdash-content';
const COUNTRIES = await getCountries();
import { getCollection } from '@/lib/emdash-content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CourseCard from '@/components/CourseCard.astro';
import Icon from '@/components/Icon.astro';
import { countryAlternates, breadcrumbSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';



const country=COUNTRIES.find(c=>c.code===Astro.params.country);
if(!country)return Astro.rewrite('/404');
const courses = (await getCollection('courses')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);
const activeCategories = CATEGORIES.filter((cat) => courses.some((c) => c.data.category === cat.slug));
---

<BaseLayout
  title={`Cursos de Globos Online en ${country.name}: Catálogo y Precios`}
  description={`Compara los 4 cursos de globos: globoflexia (50% OFF), bouquets, flores y globos burbuja. Temario, número de clases, precio y certificado de cada uno.`}
  {country}
  pathAfterCountry="/cursos/"
  alternates={await countryAlternates('/cursos/')}
  schemas={[
    breadcrumbSchema([
      { name: 'Inicio', url: `${SITE.url}/${country.code}/` },
      { name: 'Cursos', url: `${SITE.url}/${country.code}/cursos/` },
    ]),
  ]}
  pageType="catalog"
>
  <div class="contenedor pt-10 pb-16 lg:pt-12 lg:pb-24">
    <nav class="mb-6 text-xs text-ciruela-500" aria-label="Miga de pan">
      <a href={`/${country.code}/`} class="inline-block py-1 hover:text-coral-600 lg:py-0">{country.flag} {country.name}</a>
      <span aria-hidden="true"> / </span>
      <span class="font-bold text-ciruela-600">Cursos</span>
    </nav>

    <!-- Anti-canibalización: el H1 sigue la intención del <title> (catálogo y precios por país)
         y no repite el de la home ni el de /{cc}/ («Cursos de decoración con globos…»). -->
    <SectionHeading as="h1"
      eyebrow="Catálogo completo"
      title={`Catálogo de cursos de globos en ${country.name}: precios y temarios`}
      lead={`Técnicas paso a paso con certificado de estudios y acceso permanente. Los precios se muestran en ${country.currency} y el pago es seguro con Hotmart.`}
    />

    <div class="mt-8 flex flex-wrap gap-2">
      <span class="rounded-full bg-coral-600 px-4 py-2 text-xs font-extrabold text-white">Todos</span>
      {
        activeCategories.map((cat) => (
          <a
            href={`/${country.code}/cursos/${cat.slug}/`}
            class="inline-flex items-center gap-1.5 rounded-full border border-crema-300 bg-white py-2 pr-4 pl-3 text-xs font-bold text-ciruela-600 transition-colors hover:border-coral-300 hover:text-coral-600"
          >
            <Icon name={cat.icon} size={15} class="text-coral-600" />
            {cat.name}
          </a>
        ))
      }
    </div>

    <!-- 2 columnas con tarjetas horizontales en lg: con 4 cursos, a 3 columnas quedaba una huérfana. -->
    <div id="catalogo" class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        courses.map((course, i) => (
          <div class="scroll-reveal curso-item" data-title={course.data.title.toLowerCase()} style={`animation-delay:${i * 60}ms`}>
            <CourseCard {course} {country} horizontal class="h-full" />
          </div>
        ))
      }
    </div>
    <p id="sin-resultados" class="mt-10 hidden items-center justify-center gap-2 text-center text-sm text-ciruela-500">
      <Icon name="globo" class="text-coral-600" />
      No encontramos cursos con ese nombre. Escríbenos por WhatsApp y te ayudamos a elegir.
    </p>
  </div>

  <script>
    // Filtro simple ?q= desde el buscador del menú mobile
    const q = new URLSearchParams(location.search).get('q')?.toLowerCase().trim();
    if (q) {
      const items = document.querySelectorAll<HTMLElement>('.curso-item');
      let visible = 0;
      items.forEach((item) => {
        const match = (item.dataset.title ?? '').includes(q);
        item.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (visible === 0) document.getElementById('sin-resultados')?.classList.replace('hidden', 'flex');
    }
  </script>
</BaseLayout>
