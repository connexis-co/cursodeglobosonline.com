---
import { getCategories } from '@/lib/emdash-content';
const CATEGORIES = await getCategories();
import { getCountrySummaries as getCountries } from '@/lib/emdash-content';
const COUNTRIES = await getCountries();
import { getCollection } from '@/lib/emdash-content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CourseCard from '@/components/CourseCard.astro';
import { countryAlternates, breadcrumbSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';



const country=COUNTRIES.find(c=>c.code===Astro.params.country);
const category=CATEGORIES.find(c=>c.slug===Astro.params.category);
if(!country||!category)return Astro.rewrite('/404');
// Con una sola categoría activa, esta página duplica el catálogo /{cc}/cursos/ y competía
// con él y con /{cc}/ (auditoría 2026-09-22): noindex,follow hasta tener ≥ 2 categorías.
const allCourses = await getCollection('courses');
const activeCount = new Set(allCourses.map((c) => c.data.category)).size;
const courses = (await getCollection('courses'))
  .filter((c) => c.data.category === category.slug)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---

<BaseLayout
  title={`Cursos de ${category.name} en ${country.name} 🎈 Online`}
  description={`${category.short} Cursos online con certificado para ${country.name}.`}
  {country}
  pathAfterCountry={`/cursos/${category.slug}/`}
  noindex={activeCount < 2}
  alternates={await countryAlternates(`/cursos/${category.slug}/`)}
  schemas={[
    breadcrumbSchema([
      { name: 'Inicio', url: `${SITE.url}/${country.code}/` },
      { name: 'Cursos', url: `${SITE.url}/${country.code}/cursos/` },
      { name: category.name, url: `${SITE.url}/${country.code}/cursos/${category.slug}/` },
    ]),
  ]}
  pageType="category"
>
  <div class="contenedor pt-10 pb-16 lg:pt-12 lg:pb-24">
    <nav class="mb-6 text-xs text-ciruela-500" aria-label="Miga de pan">
      <a href={`/${country.code}/`} class="hover:text-coral-600">{country.flag} {country.name}</a>
      <span aria-hidden="true"> / </span>
      <a href={`/${country.code}/cursos/`} class="hover:text-coral-600">Cursos</a>
      <span aria-hidden="true"> / </span>
      <span class="font-bold text-ciruela-600">{category.name}</span>
    </nav>

    <SectionHeading as="h1"
      eyebrow="Categoría"
      title={`Cursos de ${category.name.toLowerCase()}`}
      lead={category.short}
    />

    <div class="mt-8 flex flex-wrap gap-2">
      {
        category.subcategories.map((sub) => (
          <span class="rounded-full border border-crema-300 bg-white px-3.5 py-1.5 text-xs font-bold text-ciruela-500">
            {sub.name}
          </span>
        ))
      }
    </div>

    <!-- Igual que el catálogo: 2 columnas con tarjetas horizontales en lg (sin tarjeta huérfana). -->
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        courses.map((course, i) => (
          <div class="scroll-reveal" style={`animation-delay:${i * 60}ms`}>
            <CourseCard {course} {country} horizontal class="h-full" />
          </div>
        ))
      }
    </div>

    <div class="mt-12 rounded-3xl border border-crema-200 bg-crema-100 p-8 text-center">
      <p class="font-display text-xl font-semibold text-ciruela-900">¿No sabes por cuál empezar?</p>
      <p class="mx-auto mt-2 max-w-md text-sm text-ciruela-500">
        Cuéntanos qué quieres lograr y te recomendamos el curso ideal según tu experiencia y tu presupuesto.
      </p>
      <a
        href={`/${country.code}/`}
        class="mt-5 inline-block rounded-xl bg-coral-600 px-6 py-3 text-xs font-bold text-white transition-colors hover:bg-coral-700"
      >
        Pedir asesoría gratis
      </a>
    </div>
  </div>
</BaseLayout>
