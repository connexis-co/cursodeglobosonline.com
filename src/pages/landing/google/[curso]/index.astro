---
import { getCollection } from 'astro:content';
import LandingLayout from '@/layouts/LandingLayout.astro';
import AdsLanding from '@/components/AdsLanding.astro';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map((course) => ({ params: { curso: course.id }, props: { course } }));
}

const { course } = Astro.props;
---

<LandingLayout
  title={`${course.data.title} — Inscripción con descuento`}
  description={course.data.shortDescription}
  pageType="landing_google"
>
  <AdsLanding {course} variant="google" />
</LandingLayout>
