---
import { getCourse } from '@/lib/emdash-content';
import LandingLayout from '@/layouts/LandingLayout.astro';
import AdsLanding from '@/components/AdsLanding.astro';



const course=await getCourse(Astro.params.curso!);
if(!course)return Astro.rewrite('/404');
---

<LandingLayout
  title={`${course.data.title} — Oferta especial`}
  description={course.data.shortDescription}
  pageType="landing_meta"
>
  <AdsLanding {course} variant="meta" />
</LandingLayout>
