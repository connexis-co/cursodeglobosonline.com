---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import GeoToast from '@/components/GeoToast.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import type { Country } from '@/lib/countries';
import type { ArticleMeta } from '@/components/Seo.astro';
import type { HreflangAlternate } from '@/lib/seo';
import { organizationSchema, websiteSchema } from '@/lib/seo';
import { GTM_ID, GA4_ID, META_PIXEL_ID } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  country?: Country;
  /** Ruta después del código de país, para hreflang/switcher. */
  pathAfterCountry?: string;
  alternates?: HreflangAlternate[];
  schemas?: object[];
  pageType?: string;
  whatsappContext?: string;
  noindex?: boolean;
  /** Header transparente sobre hero con imagen/video (se vuelve sólido al scroll). */
  transparentHeader?: boolean;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  ogTitle?: string;
  ogType?: 'website' | 'article';
  article?: ArticleMeta;
  canonicalPath?: string;
}

const {
  title,
  description,
  country,
  pathAfterCountry = '/',
  alternates = [],
  schemas = [],
  pageType = 'page',
  whatsappContext,
  noindex = false,
  transparentHeader = false,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
  ogTitle,
  ogType,
  article,
  canonicalPath,
} = Astro.props;

const allSchemas = [organizationSchema(), websiteSchema(), ...schemas];
---

<!doctype html>
<html lang={country?.hreflang ?? 'es'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fdf9f4" />
    <Seo
      {title}
      {description}
      {alternates}
      schemas={allSchemas}
      {noindex}
      {ogImage}
      {ogImageWidth}
      {ogImageHeight}
      {ogImageAlt}
      {ogTitle}
      {ogType}
      {article}
      {canonicalPath}
      hreflang={country?.hreflang}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      GTM_ID && (
        <script
          is:inline
          set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');`}
        />
      )
    }
    {GA4_ID && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} />}
    {
      GA4_ID && (
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('js',new Date());gtag('config','${GA4_ID}');`}
        />
      )
    }
    {
      META_PIXEL_ID && (
        <script
          is:inline
          set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','${META_PIXEL_ID}');fbq('track','PageView');`}
        />
      )
    }
  </head>
  <body data-page-type={pageType} data-country={country?.code}>
    {
      GTM_ID && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-100 focus:bg-crema-50 focus:px-4 focus:py-2 focus:text-coral-700"
    >
      Saltar al contenido
    </a>
    <Header {country} {pathAfterCountry} transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer {country} />
    <GeoToast {pathAfterCountry} currentCode={country?.code} />
    <WhatsAppFloat {country} context={whatsappContext} />

    <script>
      import { trackEvent } from '@/lib/analytics';

      // Tracking declarativo: cualquier elemento con data-track dispara su evento.
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        if (!el?.dataset.track) return;
        let params: Record<string, string | number | boolean> = {};
        try {
          params = JSON.parse(el.dataset.trackParams ?? '{}');
        } catch {
          /* params opcionales malformados: se ignoran */
        }
        trackEvent(el.dataset.track, params);
      });

      // scroll_depth 25/50/75/100 (plan de medición §10)
      const marks = [25, 50, 75, 100];
      const seen = new Set<number>();
      const onScroll = () => {
        const doc = document.documentElement;
        const percent = Math.round(((window.scrollY + window.innerHeight) / doc.scrollHeight) * 100);
        for (const m of marks) {
          if (percent >= m && !seen.has(m)) {
            seen.add(m);
            trackEvent('scroll_depth', {
              percent: m,
              page_type: document.body.dataset.pageType ?? 'page',
            });
          }
        }
        if (seen.size === marks.length) removeEventListener('scroll', onScroll);
      };
      addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
