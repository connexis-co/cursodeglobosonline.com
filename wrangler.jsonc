// Configuración de Cloudflare Pages: fuente de verdad de bindings y compatibilidad.
// El sitio es estático (Astro → dist/); solo /api/ratings corre como Pages Function.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cursodeglobosonline-com",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-06",
  // Votos de estrellas de los cursos (functions/api/ratings.ts). La sal de los hashes es
  // el secreto RATING_SALT del proyecto (wrangler pages secret put), no va aquí.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cursodeglobosonline-ratings",
      "database_id": "5c4f6bae-6301-43de-9b1b-16ac873a87ce",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    // Previews (rama develop y ramas de PR): base aparte para que las pruebas no
    // ensucien los votos reales. Los bindings no se heredan del nivel superior.
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cursodeglobosonline-ratings-preview",
          "database_id": "6343302b-4b0f-463f-abe7-9d93ca4e08f9",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
