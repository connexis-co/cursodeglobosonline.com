{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "globos-emdash-dev",
  "main": "./src/worker.ts",
  "account_id": "6e36c2fb07c21f30ed3c0d6e824884bc",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "dev.cursodeglobosonline.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "globos-emdash-dev",
      "database_id": "46f1b9d1-c426-46a7-8aa4-016bebd05595"
    },
    {
      "binding": "RATINGS_DB",
      "database_name": "globos-ratings-dev",
      "database_id": "59e66256-9615-4fa7-b8e2-09b92005da27",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "globos-emdash-dev-media"
    }
  ],
  "vars": {
    "GLOBOS_ENVIRONMENT": "development",
    "EMDASH_SITE_URL": "https://dev.cursodeglobosonline.com"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "8c8b74fc3dbd4e37823b5f8ad10a90b1"
    },
    {
      "binding": "CACHE",
      "id": "f68a42cb471343d19c33c72465c59695"
    }
  ]
}
