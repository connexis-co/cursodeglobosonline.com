{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    ".data",
    "node_modules",
    "node_modules.nosync",
    "**/*.nosync",
    "functions",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/components/*": [
        "src/themes/globos-classic/components/*"
      ],
      "@/layouts/*": [
        "src/themes/globos-classic/layouts/*"
      ],
      "@/styles/*": [
        "src/themes/globos-classic/styles/*"
      ],
      "@/*": [
        "src/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
